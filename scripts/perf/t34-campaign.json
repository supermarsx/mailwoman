{
 "schema": 1,
 "description": "t34 A/B: each mode alone, all combined, all combined with original request inputs; same shape as the 2026-11-23 baseline",
 "shape": {
  "users": 100,
  "messagesPerUser": 50,
  "cpus": 4,
  "cpuset": "0-3",
  "memory": "4g",
  "securityProfile": "enforced",
  "policy": "loaded",
  "workload": "representative",
  "endpoints": [
   "identity",
   "query",
   "headers",
   "representative"
  ],
  "concurrency": [
   8,
   32,
   64
  ],
  "seconds": 30,
  "warmupSeconds": 20,
  "repeats": 2,
  "generator": {
   "cpus": 2,
   "cpuset": "8-9",
   "memory": "1g",
   "workers": 2
  }
 },
 "arms": {
  "baseline": {
   "description": "all t34 modes off, request inputs published (production default)",
   "env": {
    "MW_GUARD_SNAPSHOT": "off",
    "MW_INDEX_PUBLICATION_ACK": "commit",
    "MW_REQUEST_PROTECTION_ACCOUNTING": "synchronous",
    "MW_NATIVE_LOAD_REQUEST_INPUTS_MODE": "published",
    "MW_LOAD_FIXTURE_REQUEST_INPUTS_EXPECT": "published"
   }
  },
  "original": {
   "description": "request inputs original, t34 modes off",
