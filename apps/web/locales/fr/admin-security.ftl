admin-probe-summary-off = Désactivée : les échecs ne sont pas comptés et rien n'est bloqué.
admin-probe-summary-grace = Tolérance : { $grace } échecs par { $window } sont pardonnés.
admin-probe-summary-tarpit = Au-delà, chaque échec reçoit une réponse après { $delay } ; { $after } échecs de plus déclenchent un blocage.
admin-probe-summary-block = Le premier blocage dure { $first } ; un blocage qui commence dans les { $repeat } suivant le précédent double, jusqu'à { $max }. Une source bloquée reçoit le statut { $status } pour tous les chemins.
admin-probe-summary-allowlist =
    { $count ->
