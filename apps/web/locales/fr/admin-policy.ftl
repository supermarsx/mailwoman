admin-policy-history = Historique
admin-policy-off = Désactivé
admin-policy-group-connections = Connexions
admin-policy-min-tls = Version TLS minimale
admin-policy-min-tls-help = S'applique à l'écouteur HTTPS et aux nouvelles connexions IMAP, SMTP, POP3, ManageSieve et proxy ; les connexions ouvertes conservent leur version.
admin-policy-min-tls-12 = TLS 1.2 et versions ultérieures
admin-policy-min-tls-13 = TLS 1.3 uniquement
admin-policy-group-sign-in = Connexion
admin-policy-group-sign-in-help = Le coût du hachage des mots de passe s'applique aux nouveaux hachages de mots de passe et de codes de récupération ; les hachages existants gardent leur coût jusqu'au changement du mot de passe.
admin-policy-require-2fa = Exiger un second facteur pour chaque compte
admin-policy-require-2fa-help = Les comptes sans second facteur sont invités à en configurer un à leur prochaine connexion ; les règles par domaine se trouvent sur la page de la double authentification.
admin-policy-argon-memory = Mémoire Argon2, en Kio
admin-policy-argon-memory-help = Mémoire utilisée pour chaque hachage de mot de passe, de { $min } à { $max } Kio ; plus de mémoire ralentit les tentatives de devinette et alourdit chaque connexion.
admin-policy-argon-single-pass = Avec une seule passe, la mémoire doit être d'au moins { $min } Kio.
admin-policy-argon-passes = Passes Argon2
admin-policy-argon-passes-help = Combien de fois le hachage parcourt sa mémoire, de 1 à { $max }.
admin-policy-argon-parallelism = Parallélisme Argon2
admin-policy-argon-parallelism-help = Threads utilisés pour chaque hachage, de 1 à { $max } ; cela ne change pas le nombre de connexions simultanées.
admin-policy-group-reading = Lecture
