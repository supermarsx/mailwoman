# t58: Security > Console address > Send by email (admin console).
# The server builds and sends the message itself; these are the dialog's strings.

admin-console-url-mail-button = Send by email
admin-console-url-mail-title = Email the console address
admin-console-url-mail-body = The server sends one message with the console address to the recipient you choose. It contains no password or code.
admin-console-url-mail-body-pending = The server sends one message with the current console address and the address that applies after the next restart. It contains no password or code.
admin-console-url-mail-recipient = Recipient
admin-console-url-mail-signin = { $address } (your sign-in name)
admin-console-url-mail-operator = { $address } (operator recipient)
admin-console-url-mail-other = Another address
admin-console-url-mail-other-label = Email address
admin-console-url-mail-other-help = One address, without a name.
admin-console-url-mail-invalid = Enter one email address, without a name or a second address.
admin-console-url-mail-send = Send
admin-console-url-mail-sent = Message queued for { $address }. It usually arrives within a minute.
admin-console-url-mail-unavailable = Sending needs outbound system email. Set it up in Compliance > Email notifications.
admin-console-url-mail-rate = Too many console address emails were sent recently. Try again later.
admin-console-url-mail-no-address = The server cannot tell its public address. Set MW_PUBLIC_URL on the server.
admin-console-url-mail-limit = Each administrator can send { $count } of these messages per hour.
