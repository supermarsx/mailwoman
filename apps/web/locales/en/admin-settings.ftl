admin-attachments-export = Export as text
admin-attachments-err-extension = Not an extension. Use letters, digits, dashes and underscores, up to 32 characters; dots may separate parts, as in tar.gz.
admin-attachments-err-mime = Not a MIME type. Use type/subtype, or type/* for every subtype.
admin-attachments-err-long = That rule is too long.
admin-attachments-invalid = Not added, not a valid rule: { $entries }
admin-attachments-duplicates = Already in the list: { $rules }
admin-attachments-overflow = A list holds at most { $max } rules. The rest were not added.
admin-attachments-conflict-blockedOverAllowed = { $rule } overlaps { $other } in the other list. Blocked rules win, so it is blocked.
admin-attachments-conflict-blockedOverWarn = { $rule } overlaps { $other } in the other list. A blocked file is refused before any warning, so the warning never shows.
admin-attachments-conflict-allowedAndWarn = { $rule } overlaps { $other } in the other list. The file is allowed and shows a warning.
admin-attachments-bytes-unit = Unit
admin-attachments-unlimited = No size limit
admin-attachments-bytes-equals = { $size } ({ $bytes } bytes)
admin-attachments-list-allowedExtensions = allowed extensions
admin-attachments-list-allowedMimeTypes = allowed MIME types
admin-attachments-list-blockedExtensions = blocked extensions
admin-attachments-list-blockedMimeTypes = blocked MIME types
admin-attachments-list-warnExtensions = warning extensions
admin-attachments-list-warnMimeTypes = warning MIME types
admin-attachments-sim-title = Test a file
admin-attachments-sim-help = Asks the server how the saved policy treats a file with this name, type and size. Nothing is changed or stored. Messages and attachments are never read.
admin-attachments-sim-filename = File name
admin-attachments-sim-mime = MIME type
admin-attachments-sim-size = Size
admin-attachments-sim-run = Test
admin-attachments-sim-invalid = Enter a file name and a size of zero or more.
admin-attachments-sim-allowed = Allowed
admin-attachments-sim-warn = Allowed with a warning
admin-attachments-sim-blocked = Not delivered
admin-attachments-sim-preview-yes = Preview is allowed.
admin-attachments-sim-preview-no = Preview is not allowed.
admin-attachments-sim-checked = Size checked: { $size }.
admin-attachments-sim-matched = Matched rules in: { $lists }.
admin-attachments-sim-matched-none = No allow, block or warning rule matched.
admin-attachments-reason-downloadsDisabled = Downloads are turned off.
admin-attachments-reason-attachmentTooLarge = The file is larger than the size limit.
admin-attachments-reason-attachmentBlocked = A block rule matches.
admin-attachments-reason-attachmentNotAllowed = An allow list exists and nothing in it matches.
admin-attachments-reason-attachmentContainerRestricted = Attached messages and TNEF files are refused while any restriction is on, because their contents are not listed.
