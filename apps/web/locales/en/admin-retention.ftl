admin-retention-age-chart = { $class }
admin-retention-age-under = Under { $days } days
admin-retention-age-between = { $from } to { $to } days
admin-retention-age-over = Over { $days } days

admin-retention-archive = Long-term archive
admin-retention-archive-intro = With the archive on, rows of the long class that pass their store's limit move into compressed, sealed files instead of being deleted. Each file is chained to the one before it, so a changed or missing file is found by a check. Files are removed once they pass the long-class limit, unless the archive is under a legal hold.
