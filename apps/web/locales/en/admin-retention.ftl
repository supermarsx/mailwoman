admin-retention-archive-state = Archive
admin-retention-archive-segments = Files
admin-retention-archive-rows = Rows
admin-retention-archive-size = Size
admin-retention-archive-verified = Last check
admin-retention-archive-failing = Files failing the check
admin-retention-archive-dir-invalid = The archive directory is not valid. It cannot contain parent-directory segments.
admin-retention-archive-hold = The archive is under a legal hold. No file is removed.
admin-retention-archive-key = New files are sealed with key generation { $generation } and written to { $directory }. Raise the generation to rotate the key; earlier files still check against their own generation.
admin-retention-archive-verify = Check the archive now
admin-retention-verify-ok = All { $count } file(s) passed the check.
admin-retention-verify-failed = { $failed } of { $count } file(s) failed the check.
