admin-ssh-no-credential = No credential is saved.
admin-ssh-public-key = Public key to install in authorized_keys
admin-ssh-key-help = Install only the public key on the SSH server. The generated private key remains sealed on this deployment.
admin-ssh-pins = Trusted server host keys
admin-ssh-algorithm = Host-key algorithm
admin-ssh-fingerprint = SHA256 host-key fingerprint
admin-ssh-add-pin = Add trusted host key
admin-ssh-remove-pin = Remove host key
