# Collapsible bars and 3-row ribbons (t38). Loaded with loadCatalog('bars').

## Pin toggle and handle, one set per bar. "pin" keeps the bar shown,
## "unpin" switches it to auto-hide, "show" and "hide" label the slim handle.
bars-pin-mail-top-bar = Keep the mail toolbar shown
bars-unpin-mail-top-bar = Auto-hide the mail toolbar
bars-show-mail-top-bar = Show the mail toolbar
bars-hide-mail-top-bar = Hide the mail toolbar
bars-pin-workspace-tabs = Keep the workspace tabs shown
bars-unpin-workspace-tabs = Auto-hide the workspace tabs
bars-show-workspace-tabs = Show the workspace tabs
bars-hide-workspace-tabs = Hide the workspace tabs
bars-pin-mail-ribbon = Keep the mail ribbon open
bars-unpin-mail-ribbon = Auto-hide the mail ribbon
bars-show-mail-ribbon = Show the mail ribbon
bars-hide-mail-ribbon = Hide the mail ribbon
bars-pin-composer-ribbon = Keep the editor ribbon open
bars-unpin-composer-ribbon = Auto-hide the editor ribbon
bars-show-composer-ribbon = Show the editor ribbon
bars-hide-composer-ribbon = Hide the editor ribbon
bars-locked = Set by your administrator
bars-mode-save-failed = Could not save the toolbar setting.

## A ribbon group folded into one dropdown button when the ribbon is too narrow.
bars-group-more = { $group }
bars-group-more-label = More { $group } commands

## Settings → Toolbars.
settings-bars-heading = Toolbars
settings-bars-help = Pinned bars stay visible. Auto-hide bars show only their tabs or a thin handle until you point at, tap or tab to them.
settings-bars-mail-top-bar = Mail toolbar
settings-bars-workspace-tabs = Workspace tabs
settings-bars-mail-ribbon = Mail ribbon
settings-bars-composer-ribbon = Editor ribbon
settings-bars-mode-pinned = Always shown
settings-bars-mode-auto = Auto-hide

## The active mailbox account indicator.
mail-account-active = Signed in as { $address }
mail-account-linked-active = Viewing linked mailbox { $address }
# A detached workspace window's title: the pane title, then the active mailbox address.
mail-popup-title = { $title } — { $address }
