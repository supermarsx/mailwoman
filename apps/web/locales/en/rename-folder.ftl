# Rename a folder (t65): the folder menu, F2 on a focused folder, and the folder tab.
rename-folder-action = Rename…
# The inline field's accessible name; { $name } is the folder's current name.
rename-folder-input = New name for { $name }
rename-folder-title = Rename “{ $name }”
rename-folder-name = Folder name
rename-folder-save = Rename
rename-folder-saving = Renaming…
rename-folder-cancel = Cancel
rename-folder-done = Folder renamed to { $name }.
rename-folder-error-empty = Enter a name for the folder.
rename-folder-error-long = The name is too long. Folder names can be up to { $max } bytes.
rename-folder-error-separator = A folder name cannot contain “{ $separator }”: the mail server uses it to separate folders.
rename-folder-error-reserved = A folder name cannot contain *, % or control characters.
rename-folder-error-duplicate = There is already a folder called { $name } here.
rename-folder-error-forbidden = This folder cannot be renamed.
rename-folder-error-not-found = This folder no longer exists. It may have been deleted on another device.
rename-folder-error-failed = The folder could not be renamed. Try again.
delete-folder-action = Delete folder
delete-folder-title = Delete { $name }?
delete-folder-description = This permanently deletes the folder. Subfolders are never deleted automatically.
delete-folder-consent = Also permanently delete all messages in this folder. This cannot be undone.
delete-folder-deleting = Deleting…
delete-folder-done = Deleted { $name }
delete-folder-error-mailboxHasEmail = This folder contains messages. Confirm permanent message deletion to continue.
delete-folder-error-mailboxHasChild = This folder has subfolders. Remove or move them first.
delete-folder-error-forbidden = You cannot delete this folder.
delete-folder-error-notFound = This folder no longer exists. Refresh the folder list.
delete-folder-error-failed = The folder could not be deleted. Try again.
