# Request history: 404 (not found) tracking (t61).
admin-history-not-found = Not found (404) per bucket
admin-history-nf-total = Not found (404) in this period
admin-history-nf-share = { $share } of requests
admin-history-nf-not-tracked-window = 404s were not tracked during this period.
admin-history-nf-not-tracked-before = 404s were not tracked before { $time }. Earlier periods show as not available, not as zero.
admin-history-nf-paths-title = Most frequent not-found paths
admin-history-nf-paths-help = Up to { $limit } paths per hour, from { $from } to { $to }, rounded out to whole hours. Query strings are removed and email addresses, numbers, IDs, tokens and long values are replaced with placeholders such as {"{"}token{"}"}. The app's own expected misses, such as browser icon requests, are not counted.
admin-history-nf-paths-approximate = More distinct paths arrived than are kept, so some counts are a range rather than an exact figure.
admin-history-nf-paths-empty = No not-found answers in this period.
admin-history-nf-paths-error = Not-found paths could not be loaded. Refresh to try again.
admin-history-nf-paths-method = Method
admin-history-nf-paths-path = Path
admin-history-nf-paths-count = Count
admin-history-nf-paths-range = { $min } to { $max }
