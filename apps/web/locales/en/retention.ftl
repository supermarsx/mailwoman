retention-fd-mandatory = The administrator keeps this folder for { $days } days
retention-fd-protected = Protected by the administrator
retention-fd-save = Save folder defaults

retention-strip-limits = Removes attachments of at least { $kb } KB from mail at least { $days } days old. The original stays in Trash for { $undo } days.
retention-strip-inline-kept = Images shown inside the message are kept.
retention-strip-inline-removed = Images shown inside the message are removed too.
