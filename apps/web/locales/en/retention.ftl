# Settings > Retention: rules for the signed-in person's own mail.
# The administrator's limits are enforced by the server; these are configurable controls and do not by themselves meet any legal requirement.

retention-title = Retention
retention-intro = Rules that move or delete your own mail after a number of days. A rule can look at a folder, a label, a sender, a size, whether the message is read, or whether it has an attachment. Flagged mail and mail labelled keep are left alone unless you change that. Deleted mail goes to Trash first and is purged after the undo window.
retention-disabled = Retention rules are turned off on this server. Your existing rules do not run.
retention-never = never
retention-error = The retention settings could not be loaded or saved. Try again.
retention-last-run = Last run: { $when }
retention-next-run = next run in about { $days } day(s)
retention-next-run-unknown = next run not scheduled yet
retention-enabled = Run my retention rules
retention-trash-first = Move deleted mail to Trash first
retention-trash-forced = This server always moves mail to Trash first and purges it after the undo window.
retention-undo = Undo window in days
retention-undo-help = Mail a rule moved to Trash stays there this long before it is purged. 0 to { $max } days.
retention-pause = Pause all rules for 30 days
retention-paused-until = Paused until { $when }
retention-resume = Resume

retention-policy = What this server allows
retention-limits-both = A rule that deletes mail waits at least { $min } days and at most { $max } days.
retention-limits-min = A rule that deletes mail waits at least { $min } days.
retention-max-rules = You can keep up to { $count } rules.
retention-permanent-allowed = A rule may delete mail permanently if you turn off the Trash step.
retention-permanent-denied = Rules cannot delete mail permanently. Mail goes to Trash and is purged after { $days } days.
retention-protected = Folders rules never touch: { $folders }.
retention-mandatory = Set by the administrator: mail in { $folder } older than { $days } days is deleted.

