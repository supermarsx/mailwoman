preview-help = Choose which files can open in the app and which tools appear. Administrator attachment restrictions and download permissions still apply.
preview-enabled-help = Choose which files can open in the app and which tools appear. Administrator attachment restrictions and download permissions still apply.
preview-max-size-help = Files larger than this limit keep their download action but do not open an inline preview. Text display is additionally limited to 512 KiB.
preview-convert-images-help = If the browser cannot decode an image, try the isolated server decoder: input up to 4 MiB, PNG output up to 8 MiB. TIFF, BMP, ICO, PNM, TGA, DDS, QOI, HDR and OpenEXR are supported. HEIC, JPEG 2000, JPEG XL and camera RAW need a browser decoder; otherwise download the original.
preview-imageFormats-help = Comma-separated image extensions, without dots. * allows every available image format. This selects formats; it does not install codecs.
preview-textExtensions-help = Comma-separated text or code extensions, without dots. Leave empty or use * to allow all recognized text formats.
preview-tools-help = Toolbar shows the tool beside the preview; More menu moves it into the three-dot menu; Hidden removes it. PDF groups keep their native layout until you override them. Download and print permissions always take precedence.
preview-image-unsupported = This image could not be decoded within the preview limits. Download the original to open it in a compatible application.
preview-invalid = This value is not accepted. Choose another one.
preview-supported-image = JPEG, PNG/APNG, GIF, WebP, AVIF, SVG, BMP, ICO/CUR, TIFF, PNM, TGA, DDS, QOI, HDR, OpenEXR
preview-supported-pdf = PDF
preview-supported-text = TXT, LOG, Markdown, CSV, TSV, text/*
preview-supported-html = HTML, HTM, XHTML
preview-supported-code = JS/TS, Python, Rust, C/C++, C#, Java, Go, JSON, XML, YAML, TOML, SQL, Shell
preview-supported-audio = MP3, WAV, OGG, FLAC, AAC, M4A
preview-supported-video = MP4, WebM, OGG, MOV
preview-supported-message = EML, RFC 822, TNEF / winmail.dat
preview-supported-calendar = ICS, ICAL, IFB
