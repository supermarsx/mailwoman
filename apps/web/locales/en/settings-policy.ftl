# Mailwoman — settings held by the administrator, the language picker and
# error references (source locale: en). Settings model C, t32 worker f01.

# Shown next to a control an administrator holds.
settings-policy-locked = Set by your administrator

# A write to a setting failed.
settings-policy-error-locked = Your administrator has set this, so it cannot be changed here.
settings-policy-error-invalid = This value is not accepted. Choose another one.
settings-policy-error-signed-out = You are signed out. Sign in again to save this.
settings-policy-error-generic = This could not be saved. Try again.
settings-policy-error-forbidden = You are not allowed to make this change.
settings-policy-error-not-found = This item no longer exists. Reload and try again.
settings-policy-error-conflict = This change conflicts with a rule of your organization or with another change. Reload and try again.
settings-policy-error-too-large = This is too large to save.
settings-policy-error-rate = Too many changes in a short time. Wait a moment and try again.

# Language picker (Settings).
settings-policy-language = Language
settings-policy-language-help = The language of menus, buttons and messages in Mailwoman.
settings-policy-language-browser = Same as the browser
settings-policy-language-saved = Language saved.

# The request id the server sent with an error, for a support request.
settings-policy-reference = Reference: { $id }
