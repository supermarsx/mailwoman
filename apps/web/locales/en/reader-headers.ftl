# Reader badges for the optional message headers.
hf-sensitivity-personal = Personal
hf-sensitivity-private = Private
hf-sensitivity-company-confidential = Company confidential
hf-sensitivity-help = The sender marked this message with a sensitivity level (Sensitivity header). It is a label; it does not protect the message.
hf-reply-by = Reply by { $date }
hf-reply-by-help = The sender asked for an answer by this time (Reply-By header).
hf-expires = Expires { $date }
hf-expired = Expired { $date }
hf-expires-help = The sender says this message is not relevant after this time (Expires header).
hf-archive-suggestion = This message has expired. You may want to archive it.
hf-supersedes = Replaces an earlier message
hf-supersedes-help = The sender says this message replaces an earlier one (Supersedes header).
hf-find = Find it
hf-superseded-by = Superseded by a newer message
hf-superseded-by-help = A newer message says it replaces this one (its Supersedes header names this message).
