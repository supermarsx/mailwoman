linked-accounts-primary-mailbox = Primary mailbox
linked-accounts-primary-mailbox-for = { $address } is your primary mailbox
linked-accounts-expired = Access expired
linked-accounts-renew = Renew access
linked-accounts-renew-tooltip = Access expired — renew
linked-accounts-renew-for = Access to { $address } expired. Renew access
linked-accounts-renew-title = Renew access to { $name }
linked-accounts-renew-help = Sign in to this mailbox again. The link stays as it is: same nickname, order and primary choice.
linked-accounts-renew-submit = Renew access
linked-accounts-renew-done = Access to { $name } renewed.
linked-accounts-renew-mismatch = That sign-in is for a different mailbox. Sign in as the mailbox this link was made for.
linked-accounts-renew-password-rejected = The password was not accepted. Check it and try again.
