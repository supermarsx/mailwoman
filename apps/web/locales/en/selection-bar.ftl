# The floating selection bar over the message list (t58).

selection-bar-label = Selection actions
selection-bar-count = { $count } selected
selection-bar-announce = { $count ->
    [one] { $count } message selected
   *[other] { $count } messages selected
}
selection-bar-select-all = Select all
selection-bar-select-none = Select none
selection-bar-clear = Clear selection
selection-bar-more = More selection actions
selection-bar-move = Move to folder
selection-bar-labels = Labels
