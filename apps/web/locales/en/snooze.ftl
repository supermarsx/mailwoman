# Message snooze presets and custom scheduling.
snooze-title = Snooze options
snooze-help = Add, rename, reorder, edit or hide snooze presets. A custom date and time is always available in the snooze menu.
snooze-custom = Choose date and time…
snooze-zone = Timezone: { $zone }
snooze-ambiguous = This clock time occurs twice. Choose an occurrence.
snooze-choose = Choose…
snooze-invalid-date = Choose a valid date and time in the future. A skipped daylight-saving time cannot be used.
snooze-kind-hours = { $count ->
    [one] In { $count } hour
   *[other] In { $count } hours
    }
snooze-kind-days = { $count ->
    [one] In { $count } day
   *[other] In { $count } days
    }
snooze-kind-tomorrow = Tomorrow
snooze-kind-next-week = Next week
snooze-kind-end-week = End of the week
snooze-kind-end-month = End of the month
snooze-kind-next-month = Next month
snooze-rule-hours = Hours from now
snooze-rule-days = Calendar days from now
snooze-rule-tomorrow = Tomorrow
snooze-rule-next-week = Next week
snooze-rule-end-week = End of the week
snooze-rule-end-month = End of the month
snooze-rule-next-month = First day of next month
snooze-add = Add preset
snooze-restore = Restore built-in presets
snooze-preset = Preset
snooze-next-time = Next snooze time
snooze-enabled = Show in menu
snooze-up = Move up
snooze-down = Move down
snooze-edit = Edit preset
snooze-name = Name (optional)
snooze-rule = Schedule rule
snooze-amount = Amount
snooze-time = Time of day
snooze-calendar-help = Hours are elapsed time. Calendar rules use the display timezone and selected time of day; week boundaries follow regional settings. If an end-of-period time has passed, the following period is used.
snooze-invalid-presets = Use up to 32 unique presets, positive whole intervals, valid times and names of up to 80 characters.
snooze-save = Save snooze options

snooze-rule-weekday = Next weekday
snooze-rule-nth-weekday = Ordinal weekday next month
snooze-rule-day-of-month = Next day of the month
snooze-rule-next-year = Next year
snooze-weekday = Weekday
snooze-occurrence = Occurrence
snooze-last = Last
snooze-month-day = Day of the month
snooze-kind-weekday = Next { $weekday }
snooze-kind-nth-weekday = Occurrence { $ordinal } of { $weekday } next month
snooze-kind-last-weekday = Last { $weekday } next month
snooze-kind-day-of-month = Next day { $day } of the month
snooze-kind-next-year = Next year
schedule-defaults-help = Only Later today, Tomorrow and Next week are enabled by default. Other presets are already available to enable or customize.
snooze-calendar-advanced-help = Next weekday always means a later date. An ordinal weekday is in the next calendar month; a missing fifth occurrence is unavailable. Day-of-month rules skip months without that day. Next year means January 1. Dates use your regional time zone.
follow-up-help = Choose follow-up reminder times independently of snooze. Follow-up flags keep messages visible; snoozing hides them until the selected time. Local choices can override inherited defaults when administrator policy allows.
follow-up-title = Flag for follow-up
follow-up-save = Save
