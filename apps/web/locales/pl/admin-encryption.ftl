admin-encryption-rehearsing = Uruchamianie…
admin-encryption-refresh = Odśwież
admin-encryption-verify-passed = Zweryfikowano: plik bazy danych jest zaszyfrowany, a klucz działa.
admin-encryption-verify-failed = Nie zweryfikowano.
admin-encryption-pass = Zaliczone
admin-encryption-fail = Niezaliczone
admin-encryption-check-header-not-sqlite = Plik nie zaczyna się od nagłówka SQLite
