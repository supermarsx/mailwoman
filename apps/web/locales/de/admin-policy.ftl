admin-oauth-scope-permissions = Berechtigungen
admin-oauth-scope-surfaces = Teile des Kontos
admin-oauth-scope-read = Lesen
admin-oauth-scope-send = Senden
admin-oauth-scope-delete = Löschen
admin-oauth-scope-mail = E-Mail
admin-oauth-scope-pim = Kalender, Kontakte, Aufgaben und Notizen
admin-oauth-scope-rate = Anfragen pro Minute
admin-oauth-scope-rate-help = Leer lassen für keine Begrenzung.
admin-oauth-scope-needs-surface = Wählen Sie auch E-Mail oder Kalender und Kontakte: Eine Berechtigung ohne Teil des Kontos gewährt nichts.
admin-oauth-scope-rate-invalid = Die Begrenzung muss eine ganze Zahl ab 1 sein.
admin-policy-dlp-detector-pt-nif = Portugiesische Steuernummer (NIF, Prüfsumme)
