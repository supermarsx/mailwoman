packages-status-InfoReceived = Zendinginformatie ontvangen
packages-status-InTransit = Onderweg
packages-status-OutForDelivery = Wordt bezorgd
packages-status-AttemptFail = Bezorgpoging mislukt
packages-status-Delivered = Bezorgd
