admin-db-online-started = Gestart
admin-db-online-finished = Voltooid
admin-db-online-elapsed = Verstreken tijd
admin-db-online-copy-rate = Gemiddelde kopieersnelheid
admin-db-online-replay-rate = Gemiddelde herhaalsnelheid
