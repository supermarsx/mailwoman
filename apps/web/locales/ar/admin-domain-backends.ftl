# -- Machine translation (2026-11): added to match en ---------------------
backend-editor-title = إعداد الواجهة الخلفية
backend-editor-add = إضافة واجهة خلفية
backend-editor-edit = تحرير الواجهة الخلفية
backend-editor-intro = اضبط نقطة نهاية خدمة واحدة وهوية المصادقة الخاصة بها.
backend-editor-back = العودة إلى النطاق
backend-editor-identity = الخدمة والاختيار
backend-editor-id = معرّف الواجهة الخلفية
backend-editor-id-help = معرّف ثابت وفريد ضمن هذا النطاق. استخدم الأحرف والأرقام والواصلات أو الشرطات السفلية. لا يمكن إعادة تسمية المعرّفات الحالية.
backend-editor-protocol = البروتوكول والخدمة
backend-editor-protocol-help = توفّر IMAP وPOP3 وJMAP البريد؛ وتوفّر EWS البريد والإرسال؛ وتوفّر SMTP الإرسال؛ وتوفّر ManageSieve قواعد الخادم. لا يمكن حاليًا الجمع بين وضع وكيل JMAP ووضع محرّك البريد في خادم واحد.
backend-editor-priority = الأولوية
backend-editor-priority-help = الأرقام الأقل تتقدّم. تُختار الواجهة الخلفية المفضلة أولًا؛ وعند التساوي يُستخدم معرّف الواجهة. لا يعيد الاختيار محاولة بيانات الاعتماد على واجهة أخرى أبدًا.
backend-editor-enabled = مفعّلة
backend-editor-enabled-help = تُستبعد الواجهات الخلفية المعطّلة من الاختيار. إذا لم تبقَ واجهة بريد مفعّلة يُرفض تسجيل الدخول؛ ولا يوجد بديل ضمني.
backend-editor-preferred = المفضلة لهذه الخدمة
backend-editor-preferred-help = تفضيل هذه الواجهة الخلفية على الأولويات الأخرى. يُلغي الحفظ الواجهة المفضلة السابقة لهذه الخدمة.
backend-editor-connection = الاتصال
backend-editor-host = اسم المضيف أو عنوان IP
backend-editor-host-help = يُحلّ اسم المضيف ويُفحص عند كل اتصال جديد، فتسري تحديثات DNS. يثبّت عنوان IP الحرفي الوجهة. لا تُدخل هنا نظامًا أو مسارًا أو منفذًا.
backend-editor-port = المنفذ
backend-editor-port-help = منفذ TCP لنقطة النهاية هذه، من 1 إلى 65535. طابِق مستمع TLS أو STARTTLS على الخادم.
backend-editor-security = أمان الاتصال
backend-editor-security-help = يشفّر TLS فورًا. يتطلب STARTTLS ترقية ناجحة قبل المصادقة. التحقق من الشهادة صارم؛ ولا يؤدي الفشل إلى خفض مستوى الاتصال.
backend-editor-plaintext = نص عادي (اختيار صريح غير آمن)
backend-editor-plaintext-warning = يرسل النص العادي بيانات الاعتماد والبريد بلا تشفير للنقل. اخترْه فقط لنقطة نهاية محلية موثوقة صراحةً.
backend-editor-private = السماح بنقطة النهاية هذه على شبكة خاصة
backend-editor-private-help = يسمح بعناوين الشبكة المحلية الخاصة وعناوين الحلقة الراجعة لنقطة النهاية المضبوطة هذه فقط. تبقى عناوين البيانات الوصفية والرابط المحلي والعناوين المحظورة المضمّنة مرفوضة.
backend-editor-advanced-ready = أمان النقل المتقدم متاح للبروتوكولات المدعومة.
backend-editor-advanced-unavailable = التفاوض التلقائي على الأمان وسلطات الشهادات المخصصة وتجاوز اسم TLS غير متاحة إلى أن يدعمها نقل الخادم. نقل SSH غير متصل بعد.
backend-editor-session-url = عنوان URL لجلسة JMAP
backend-editor-session-help = عنوان URL لاكتشاف جلسة HTTP(S) الذي وافق عليه المشغّل. لا تُضمّن بيانات اعتماد أو أجزاء أو عنوان URL لصندوق بريد.
backend-editor-auth = المصادقة
backend-editor-auth-help = تستخدم وسائل نقل البريد هذه حاليًا كلمة مرور المستخدم. تتطلب مصادقة OAuth وشهادة العميل دعمًا منفصلًا وقت التشغيل ولا يمكن اختيارها هنا.
backend-editor-username-format = صيغة اسم مستخدم المصادقة
backend-editor-username-help = يتغير اسم المستخدم المرسَل إلى هذه الواجهة فقط. تبقى معرّفات الحسابات وهويات البريد والأسماء المستعارة وموضوعات السياسة كما هي. يستخدم JMAP حاليًا هوية البريد كاملة.
backend-editor-format-fullEmail = عنوان البريد الكامل
backend-editor-format-localUser = اسم المستخدم المحلي
backend-editor-format-domainUser = DOMAIN\username
backend-editor-format-userRealm = username@realm
backend-editor-format-custom = قالب مخصص
backend-editor-auth-domain = نطاق المصادقة
backend-editor-auth-domain-help = الدليل أو نطاق Windows الموضوع قبل الشرطة المائلة العكسية، مثل CORP. لا يغيّر هذا نطاق البريد.
backend-editor-realm = نطاق (realm) المصادقة
backend-editor-realm-help = نطاق المصادقة الصريح للخادم. مطلوب لـ username@realm أو لرمز نطاق مخصص.
backend-editor-template = قالب اسم المستخدم
backend-editor-template-help = استخدم رموز المستخدم والنطاق والبريد والنطاق (realm) الاختياري بين أقواس معقوصة. ضمّن المستخدم أو البريد. القوالب استبدال نصي فقط، وليست شيفرة قابلة للتنفيذ أبدًا.
backend-editor-example = مثال على هوية البريد
backend-editor-example-help = معاينة اسم مستخدم المصادقة بدقة دون إرسال بيانات اعتماد أو الاتصال بأي خادم منبع.
backend-editor-preview-username = معاينة اسم مستخدم المصادقة
backend-editor-preview-result = اسم مستخدم المصادقة
backend-editor-save-help = يغيّر الحفظ الإعداد المحدد للنطاق. يجب أن تسجّل الحسابات الحالية الدخول مجددًا إذا تغيّرت جهة الاعتماد المحددة أو سياسة المصادقة.
backend-editor-save = حفظ الواجهة الخلفية
backend-list-title = الواجهات الخلفية للخدمات
backend-list-help = تختار كل خدمة واجهتها الخلفية المفضلة المفعّلة، ثم الأقل أولوية ومعرّفًا. لا تُعاد محاولة بيانات الاعتماد على واجهة خلفية أخرى أبدًا.
backend-list-failover = التحويل إلى الواجهة الخلفية التالية للبريد عند تعذّر الوصول إلى المحددة
backend-list-failover-help = ينطبق على IMAP وPOP3. قبل تسجيل الدخول، تفحص Mailwoman الواجهة الخلفية المحددة بلا بيانات اعتماد؛ وعند فشل DNS أو الاتصال أو انتهاء المهلة أو TLS أو الشهادة تفحص الواجهة التالية المفعّلة من البروتوكول نفسه، بحد أقصى ثلاث. لا تُجرَّب كلمة مرور مرفوضة على واجهة أخرى أبدًا. تُتخطّى الواجهة الفاشلة لمدة 30 ثانية، وتتضاعف مع كل فشل حتى 15 دقيقة، ثم تُجرَّب أولًا مجددًا. يُكتب كل تحويل في سجل التطبيق. يجب أن تستخدم كل الواجهات في السلسلة أمان الاتصال والمصادقة وصيغة اسم المستخدم نفسها، ويطلب تفعيل هذا من الحسابات الحالية تسجيل الدخول مجددًا.
backend-list-selected = المحددة
backend-list-none = لم تُحدَّد واجهة خلفية مفعّلة
backend-list-upgrade = تؤدي إضافة واجهة خلفية أو تحريرها إلى ترقية النطاق إلى اختيار صريح لنقاط النهاية. لا يعود البريد يرجع إلى الإعدادات الافتراضية للنشر.
backend-list-edit = تحرير
backend-list-add = إضافة واجهة خلفية
backend-list-role-mail = الوصول إلى البريد
backend-list-role-submission = إرسال الرسائل
backend-list-role-rules = قواعد الخادم
backend-editor-forbidden = لا يمكن لدور المسؤول لديك تغيير اتصالات الواجهات الخلفية.
backend-editor-missing = لم تعد هذه الواجهة الخلفية موجودة. ارجع إلى النطاق وأعد تحميل إعداده.
backend-security-title = أمان النقل المتقدم
backend-security-dane = التحقق عبر DANE
backend-security-dane-auto = الإلزام عند وجود سجلات TLSA آمنة
backend-security-dane-help = يتحقق من DNSSEC وشهادة TLS لمضيف SMTP ومنفذه. يرفض الوضع المطلوب نقاط النهاية التي ليس لها سجلات TLSA صالحة ومتحقَّق منها بأمان.
backend-security-sts = التحقق عبر MTA-STS
backend-security-sts-auto = اتباع السياسة المنشورة
backend-security-policy-off = معطّل
backend-security-policy-required = مطلوب
backend-security-policy-domain = نطاق سياسة SMTP
backend-security-policy-domain-help = النطاق الذي ينشر السياسة لمرحّل SMTP هذا. يجب أن تسمح سياسته بهذا المضيف؛ ولا تُستخدم نطاقات المستلمين.
backend-security-policy-help = اختر طريقة TLS أو STARTTLS ثابتة دون تجاوز اسم الخادم. تُفحص السياسات قبل المصادقة أو الإرسال. تُبقي الإعدادات الحالية هذه الفحوصات معطّلة حتى تُضبط.
backend-security-customize = تخصيص أمان النقل
backend-security-customize-help = تجاوز إعداد TLS البسيط بقواعد تفاوض وثقة بالشهادات صريحة لنقطة النهاية هذه فقط.
backend-security-mode = اختيار الأمان
backend-security-fixed = طريقة ثابتة
backend-security-auto = تلقائي، بأولوية صريحة
backend-security-mode-help = يستخدم الثابت طريقة واحدة. يفحص التلقائي الطرق المسموح بها قبل المصادقة ولا ينتقل إلا بعد استجابة صريحة بعدم دعم الطريقة. لا تؤدي أخطاء الشهادة أو انتهاء المهلة أو فشل المصادقة إلى بديل أبدًا.
backend-security-order = أولوية الطريقة { $index }
backend-security-order-help = الطرق الأسبق تتقدم. لا تكرّر الطرق. الخانات الفارغة اللاحقة غير مستخدمة. يتطلب النص العادي إذنًا صريحًا أدناه.
backend-security-unused = غير مستخدمة
backend-security-plaintext = السماح صراحةً بالنص العادي
backend-security-plaintext-help = لا يضيف هذا النص العادي تلقائيًا. إنه يسمح فقط بطريقة نص عادي مدرجة صراحةً. لا تستخدمه أبدًا عبر شبكة غير موثوقة.
backend-security-server-name = تجاوز اسم خادم TLS
backend-security-server-name-help = اسم مضيف الشهادة وSNI الاختياريان، مثل mail.example.com عند الاتصال بعنوان IP ثابت. يظل التحقق إلزاميًا ويجب أن يطابق هذا الاسم.
backend-security-ca = شهادات CA موثوقة إضافية (PEM)
backend-security-ca-help = شهادات CA عامة اختيارية لسلطة شهادات داخلية. تبقى الجذور العامة للنظام موثوقة. بلا مفاتيح خاصة؛ بحد أقصى 64 KiB.
backend-security-verify = تُتحقَّق دائمًا من توقيعات الشهادات وصلاحيتها وأسماء الخوادم. لا يوجد مفتاح لتعطيل التحقق.
backend-auth-mechanisms-title = طرق المصادقة بكلمة المرور
backend-auth-customize = تخصيص طرق المصادقة
backend-auth-customize-help = حدّد آليات كلمة المرور التي يجوز لنقطة النهاية هذه استخدامها. بدون هذا التجاوز يُحافَظ على سلوك المصادقة الحالي للبروتوكول.
backend-auth-unavailable = اختيار المصادقة الصريح غير متاح على هذا الخادم أو البروتوكول. رموز OAuth وشهادات العميل ليست آليات كلمة مرور.
backend-auth-mode = اختيار المصادقة
backend-auth-mode-help = يتطلب الثابت طريقة واحدة. يختار التلقائي أول طريقة مسموح بها مدعومة على الاتصال المؤمَّن. يجب أن تُعلَن طرق SASL؛ ويتبع IMAP LOGIN القياسي وPOP3 USER/PASS القديم قواعد أوامر بروتوكولهما. لا تُعاد محاولة مرفوضة بطريقة أخرى أو بواجهة خلفية أخرى أبدًا.
backend-auth-priority = أولوية المصادقة { $index }
backend-auth-priority-help = الطرق الأسبق تتقدم. لا تكرّر الطرق. الخانات الفارغة اللاحقة غير مستخدمة. تفشل الطرق غير المدعومة قبل إرسال بيانات الاعتماد.
backend-auth-plus-help = يتطلب SCRAM-PLUS اتصال TLS متحقَّقًا منه مع ربط القناة ودعمًا من الخادم. لا يدعم ManageSieve حاليًا PLUS. تعتمد بيانات اعتماد Plain وLOGIN في سريّتها على النقل المضبوط.
backend-auth-mechanism-plain = SASL PLAIN
backend-auth-mechanism-login = SASL LOGIN
backend-auth-mechanism-scram-sha-256 = SCRAM-SHA-256
backend-auth-mechanism-scram-sha-256-plus = SCRAM-SHA-256-PLUS
backend-auth-mechanism-imap-login = أمر IMAP LOGIN
backend-auth-mechanism-pop3-user-pass = أوامر POP3 USER/PASS
backend-ews-endpoint = نقطة نهاية Exchange Web Services
backend-ews-endpoint-help = نقطة نهاية HTTPS الدقيقة، مثل https://exchange.example.org/EWS/Exchange.asmx. لا يُسمح ببيانات الاعتماد أو سلاسل الاستعلام أو الأجزاء في عنوان URL.
backend-ews-auth = مصادقة EWS
backend-ews-basic = HTTPS Basic
backend-ews-auth-help = يستخدم كلمة مرور المستخدم الذي يسجّل الدخول عبر TLS متحقَّق منه. لا يدعم تكامل النطاق هذا OAuth وNTLM وMAPI.
backend-ews-ca = شهادات CA إضافية للمصدر (اختياري)
backend-ews-ca-help = شهادات PEM فقط، بحد أقصى 8 شهادات و64 KiB. بلا مفاتيح خاصة. يبقى التحقق من اسم المضيف وسلسلة الشهادات مفعّلًا؛ وثقة الوكيل لا تتغير. اتركه فارغًا لاستخدام ثقة النظام.
backend-ews-routing-help = توفّر EWS إرسال البريد بنفسها. عطّل واجهتي SMTP وSieve المنفصلتين عند اختيار EWS. تتطلب الخوادم الخاصة إذن وجهة صريحًا للإضافات في التوجيه الصادر؛ ولا يمنح هذا النموذج أي استثناء للشبكة.
backend-ews-diagnostics-help = يتحقق الحفظ من الإعداد لا من بيانات الاعتماد أو توفر الخدمة. لا يمكن للتشخيص بلا مصادقة اختبار EWS؛ ويلزم اتصال ناجح ومُصادَق به بالمزوّد.
backend-ews-invalid = أدخل نقطة نهاية EWS صالحة عبر HTTPS بلا بيانات اعتماد أو استعلام أو جزء، مع مصادقة Basic ودون إعداد مقبس أو JMAP.
backend-ews-invalid-ca = أدخل من 1 إلى 8 شهادات CA بصيغة PEM، بلا مفاتيح خاصة، وضمن 64 KiB. يتحقق الخادم من الشهادات أيضًا.
backend-ews-service-conflict = توفّر واجهة EWS الخلفية المحددة الإرسال. عطّل واجهتي SMTP وSieve المفعّلتين، أو اختر واجهة بريد أخرى، قبل الحفظ.
