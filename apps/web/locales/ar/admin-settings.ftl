admin-image-proxy-disk = طبقة القرص: المستخدم { $bytes } من { $budget } الفعلي ({ $mode }؛ الحد الأدنى { $floor }، الحد الأعلى { $ceiling }، اليدوي { $manual })، { $entries } صورة، { $hot } ساخنة، { $cold } باردة، معدل الإصابة { $hit }.
admin-image-proxy-disk-inactive = طبقة القرص: مفعّلة لكنها غير نشطة. { $reason }
admin-image-proxy-moves = الترقيات في الدقيقة: { $perMin }. إجمالي الترقيات { $promotions }، والخفض { $demotions }، والإسقاط { $drops }. إدخالات الفهرس: { $index }.
admin-image-proxy-refresh = تحديث القراءة
admin-settings-key-security-trust-enabled = مستويات الثقة
admin-settings-help-security-trust-enabled = يمنح كل طلب مستوى: مسجَّل الدخول، أو مصدر معروف (تسجيل دخول ناجح حديث من ذلك العنوان)، أو غير معروف. تتغير فقط حصص الطلبات المجهولة؛ ولا يُخفَّف أبدًا شيء من بيانات الاعتماد أو العوامل الثانية أو أقفال الحظر.
admin-settings-key-security-trust-known-ttl-days = نافذة المصدر المعروف (بالأيام)
admin-settings-help-security-trust-known-ttl-days = المدة التي يُبقي فيها تسجيل دخول ناجح عنوانه معروفًا. المحاولات الفاشلة لا تُحتسب أبدًا.
admin-settings-key-security-trust-known-capacity = عدد المصادر المعروفة المحفوظة
admin-settings-help-security-trust-known-capacity = أكبر عدد من المصادر المعروفة المحفوظة في الذاكرة (لكل منها تجزئة مملَّحة وبلد وعدد حسابات). يُسقَط الأقدم أولًا.
admin-settings-key-security-trust-persist = حفظ المصادر المعروفة عبر إعادة التشغيل
admin-settings-help-security-trust-persist = يحفظ جدول المصادر المعروفة (تجزئات مفتاحية، البلد، وقت آخر ظهور، عدد الحسابات) في مخزن الإعدادات ويحمّله عند بدء التشغيل. تُسقَط الإدخالات الأقدم من النافذة.
admin-settings-key-security-trust-persist-interval-secs = فاصل حفظ المصادر المعروفة (بالثواني)
admin-settings-help-security-trust-persist-interval-secs = الثواني بين عمليات الحفظ، من 30 إلى 3600. لا يحدث الحفظ إلا عند تغيّر الجدول، ومرة أخرى عند الإيقاف السليم.
admin-settings-key-security-trust-unknown-percent = حصة المصدر غير المعروف (%)
admin-settings-help-security-trust-unknown-percent = حصة الطلبات المجهولة لمصدر غير معروف كنسبة مئوية من الحدود المضبوطة. 100 يُبقي الخط الأساسي؛ والأقل أكثر صرامة.
admin-settings-key-security-trust-known-percent = حصة المصدر المعروف (%)
admin-settings-help-security-trust-known-percent = حصة الطلبات المجهولة لمصدر معروف. 200 يضاعف ميزانيات الطلبات ويخفض مهلة تسجيل الدخول وصعوبة التحدي إلى النصف. لا يتجاوز أبدًا بيانات الاعتماد أو العوامل الثانية أو أقفال الحظر.
admin-settings-key-security-trust-ua-missing = الروبوتات: User-Agent فارغ
admin-settings-help-security-trust-ua-missing = الإجراء للطلبات المجهولة ذات User-Agent فارغ: السماح أو التقييد أو الحظر. لا تتأثر جلسات تسجيل الدخول أبدًا.
admin-settings-key-security-trust-ua-uncommon = الروبوتات: User-Agent غير معروف
admin-settings-help-security-trust-ua-uncommon = الإجراء للطلبات المجهولة ذات User-Agent غير معروف: السماح أو التقييد أو الحظر.
admin-settings-key-security-trust-ua-automation = الروبوتات: النصوص البرمجية والأتمتة
admin-settings-help-security-trust-ua-automation = الإجراء للطلبات المجهولة التي تدّعي أنها نص برمجي أو مكتبة HTTP أو متصفح بلا واجهة أو روبوت عام: السماح أو التقييد أو الحظر.
admin-settings-key-security-trust-ua-search = الروبوتات: زواحف البحث
admin-settings-help-security-trust-ua-search = الإجراء للطلبات المجهولة التي تدّعي أنها زاحف محرك بحث: السماح أو التقييد أو الحظر.
admin-settings-key-security-trust-ua-ai-training = الروبوتات: زواحف تدريب الذكاء الاصطناعي
admin-settings-help-security-trust-ua-ai-training = الإجراء للطلبات المجهولة التي تدّعي أنها GPTBot أو ClaudeBot أو CCBot أو Amazonbot أو Bytespider أو Google-Extended أو Applebot-Extended: السماح أو التقييد أو الحظر. الادعاء ترويسة وليس هوية مُتحقَّقًا منها.
admin-settings-key-security-trust-ua-ai-search = الروبوتات: زواحف بحث الذكاء الاصطناعي
admin-settings-help-security-trust-ua-ai-search = الإجراء للطلبات المجهولة التي تدّعي أنها OAI-SearchBot أو PerplexityBot أو Claude-SearchBot: السماح أو التقييد أو الحظر.
admin-settings-key-security-trust-ua-ai-user = الروبوتات: جالبات مستخدمي الذكاء الاصطناعي
admin-settings-help-security-trust-ua-ai-user = الإجراء للطلبات المجهولة التي تدّعي أنها ChatGPT-User أو Claude-User: السماح أو التقييد أو الحظر.
admin-settings-key-security-trust-ua-custom = الروبوتات: أنماط مخصصة
admin-settings-help-security-trust-ua-custom = الإجراء للطلبات المجهولة المطابقة لأنماط User-Agent المخصصة: السماح أو التقييد أو الحظر.
admin-settings-key-security-trust-admin-geo-enabled = حظر اكتشاف الإدارة من بلدان غير معروفة
admin-settings-help-security-trust-admin-geo-enabled = يحظر المصدر الذي يستكشف وحدة تحكم الإدارة من بلد ليس له تسجيل دخول ناجح حديث. يتطلب قاعدة بيانات بلدان قابلة للقراءة وحماية من استكشاف الإدارة. يؤدي ضبط MW_ADMIN_GEO_ENABLED=false إلى إيقافه للاسترداد.
admin-settings-key-security-trust-admin-geo-countries = بلدان معروفة دائمًا (حظر الإدارة)
admin-settings-help-security-trust-admin-geo-countries = رموز ISO للبلدان بأحرف كبيرة تُعامل دائمًا كمعروفة، إضافة إلى بلدان تسجيلات الدخول الناجحة الحديثة.
admin-settings-key-security-trust-admin-geo-lookup-failure = مصدر بلا بلد
admin-settings-help-security-trust-admin-geo-lookup-failure = allow لا يحظر ويسجّل الحالة؛ unknown يعامل المصدر الذي لم يُكتشف له بلد كبلد غير معروف.
admin-settings-key-security-trust-admin-geo-threshold = عدد الاستكشافات قبل الحظر
admin-settings-help-security-trust-admin-geo-threshold = عدد استكشافات الإدارة من بلد غير معروف ضمن النافذة التي يبدأ عندها الحظر.
admin-settings-key-security-trust-admin-geo-window-secs = نافذة الاستكشاف (بالثواني)
admin-settings-help-security-trust-admin-geo-window-secs = النافذة المستخدمة لحد الاستكشاف.
admin-settings-key-security-trust-admin-geo-block-on-first = الحظر عند أول استكشاف
admin-settings-help-security-trust-admin-geo-block-on-first = الحظر عند أول استكشاف من بلد غير معروف. يزيد احتمال إقفال مسؤول مسافر.
admin-settings-key-security-trust-admin-geo-block-secs = الحظر الأول (بالثواني)
admin-settings-help-security-trust-admin-geo-block-secs = مدة الحظر الأول.
admin-settings-key-security-trust-admin-geo-second-block-secs = الحظر الثاني (بالثواني)
admin-settings-help-security-trust-admin-geo-second-block-secs = مدة الحظر الثاني للمصدر نفسه ضمن فترة التكرار.
admin-settings-key-security-trust-admin-geo-max-block-secs = الحظر المتكرر (بالثواني)
admin-settings-help-security-trust-admin-geo-max-block-secs = مدة الحظر الثالث وكل حظر لاحق ضمن فترة التكرار.
admin-settings-key-security-trust-admin-geo-repeat-days = فترة التكرار (بالأيام)
admin-settings-help-security-trust-admin-geo-repeat-days = يُعدّ الحظر الواقع خلال هذا العدد من الأيام من الحظر السابق تكرارًا ويستخدم المدة الأطول التالية.
admin-settings-key-security-signin-account-geo-mode = سياسة بلد تسجيل الدخول لكل حساب
admin-settings-help-security-signin-account-geo-mode = متوقفة افتراضيًا. تحظر تسجيلات الدخول من بلدان لم يستخدمها الحساب من قبل، أو من أي بلد خارج قائمته المسموحة. العناوين والبلدان في قائمة السماح تمر دائمًا. تنطبق على تسجيلات دخول البريد عبر الويب الجديدة فقط، ولا تنطبق أبدًا على الجلسات القائمة أو عملاء البروتوكولات. يعتمد اكتشاف البلد على قاعدة بيانات تحديد المواقع الجغرافية لعناوين IP التي قد تكون خاطئة أو قديمة؛ وقد تحظر الشبكات الافتراضية الخاصة ومشغلو الجوال والوكلاء والسفر تسجيل دخول مشروعًا أو تسمح بتسجيل دخول أجنبي. أضف عناوين IP أو بلدانًا موثوقة إلى قائمة السماح.
admin-settings-key-security-signin-account-geo-allow-countries = البلدان المسموحة للحساب
admin-settings-help-security-signin-account-geo-allow-countries = رموز ISO للبلدان بأحرف كبيرة المسموحة دائمًا للحساب. يعتمد اكتشاف البلد على قاعدة بيانات تحديد المواقع الجغرافية لعناوين IP التي قد تكون خاطئة أو قديمة؛ وقد تحظر الشبكات الافتراضية الخاصة ومشغلو الجوال والوكلاء والسفر تسجيل دخول مشروعًا أو تسمح بتسجيل دخول أجنبي. أضف عناوين IP أو بلدانًا موثوقة إلى قائمة السماح.
admin-settings-key-security-signin-account-geo-allow-ips = عناوين IP المسموحة للحساب
admin-settings-help-security-signin-account-geo-allow-ips = عناوين IP أو شبكات CIDR المسموحة دائمًا للحساب. عنوان IPv6 واحد يعني شبكته /64.
admin-settings-key-security-signin-account-geo-global-allow-countries = البلدان المسموحة لكل الحسابات
admin-settings-help-security-signin-account-geo-global-allow-countries = رموز ISO للبلدان بأحرف كبيرة المسموحة لكل الحسابات، وتُضاف إلى قائمة كل حساب الخاصة.
admin-settings-key-security-signin-account-geo-global-allow-ips = عناوين IP المسموحة لكل الحسابات
admin-settings-help-security-signin-account-geo-global-allow-ips = عناوين IP أو شبكات CIDR (مكتب أو شبكة افتراضية خاصة) المسموحة لكل الحسابات، وتُضاف إلى قائمة كل حساب الخاصة.
admin-settings-key-security-signin-account-geo-lookup-failure = مصدر بلا بلد (سياسة الحساب)
admin-settings-help-security-signin-account-geo-lookup-failure = عندما لا يُكتشف بلد للمصدر: السماح بتسجيل الدخول وتسجيله في السجل، أو رفضه.
admin-settings-key-security-signin-account-geo-history-days = سجل بلدان الحساب (بالأيام)
admin-settings-help-security-signin-account-geo-history-days = عدد الأيام التي يبقى فيها البلد في سجل تسجيل دخول الحساب الخاص لسياسة البلدان غير المعتادة. يُحفظ بمعزل عن سجل المصادقة، فلا يؤدي تقصير السجل إلى تقصيره.
admin-settings-key-security-geo-no-database = لا توجد قاعدة بيانات بلدان: السلوك الافتراضي
admin-settings-help-security-geo-no-database = ما تفعله ميزات البلد عند عدم تحميل قاعدة بيانات: السماح، أو معاملة المصدر كبلد غير معروف، أو الحظر (ينطبق الحظر على تسجيلات الدخول فقط). يسري أيضًا إعداد الميزة نفسها ويغلب الأكثر صرامة.
admin-settings-key-security-geo-not-found = العنوان غير موجود في قاعدة البيانات: السلوك الافتراضي
admin-settings-help-security-geo-not-found = ما تفعله ميزات البلد عند تحميل قاعدة بيانات دون إدخال للعنوان. العناوين الخاصة وعناوين الحلقة الراجعة والمحلية للرابط هي شبكات محلية ولا تتأثر أبدًا.
admin-settings-key-security-signin-geo-no-database = سياسة تسجيل دخول المثيل دون قاعدة بيانات
admin-settings-help-security-signin-geo-no-database = عندما تكون سياسة بلد تسجيل دخول المثيل مفعّلة ولا توجد قاعدة بيانات محمّلة: حظر تسجيلات الدخول (الإغلاق عند الفشل) أو السماح بها دون فحص. الشبكات المحلية مسموحة دائمًا.
admin-settings-key-security-geo-session-lookup-failure = تنبيهات الجلسة بلا بلد
admin-settings-help-security-geo-session-lookup-failure = عندما يتعذر تحديد بلد طلب مسجَّل الدخول: تجاهله، أو إصدار تنبيه جلسة واحد لكل جلسة في اليوم. لا يحظر جلسة ولا يلغيها أبدًا.
admin-settings-key-security-protocol-framing-mode = حارس البروتوكول: تأطير الطلب
admin-settings-help-security-protocol-framing-mode = فئة تهريب الطلبات: Content-Length مع Transfer-Encoding، وTransfer-Encoding غير chunked تمامًا (أو على HTTP/1.0 وHTTP/2)، وContent-Length غير رقمي أو متعارض. يردّ الإنفاذ بـ 400 ويغلق الاتصال؛ والكشف فقط يكتفي بالعدّ. لا يسري إعفاء بادئة المسار على هذه الفئة أبدًا.
admin-settings-key-security-protocol-host-mode = حارس البروتوكول: صيغة Host
admin-settings-help-security-protocol-host-mode = صيغة ترويسة Host: مفقودة في HTTP/1.1، أو فارغة، أو مكرّرة، أو تحتوي على معلومات مستخدم أو مسافات أو أحرف مسار. تُقبل عناوين IPv6 الحرفية والمنافذ والنقطة الأخيرة. يردّ الإنفاذ بـ 400 ويغلق الاتصال.
admin-settings-key-security-protocol-host-pinning-mode = حارس البروتوكول: يجب أن يطابق Host الاسم العام
admin-settings-help-security-protocol-host-pinning-mode = Host لا يطابق مضيف MW_PUBLIC_URL ولا أحد allowedHosts. لا يفعل شيئًا ما دام أيٌّ منهما لا يحدد مضيفًا. الكشف هو الافتراضي لأن الوكلاء وفحوصات الصحة قد ترسل اسمًا داخليًا.
admin-settings-key-security-protocol-path-control-mode = حارس البروتوكول: أحرف التحكم في المسار
admin-settings-help-security-protocol-path-control-mode = NUL أو أحرف تحكم أو CR/LF مرمَّزة (%00 و%0d و%0a) في مسار الطلب. يردّ الإنفاذ بـ 400. لا تُعفى أبدًا ببادئة مسار.
admin-settings-key-security-protocol-target-mode = حارس البروتوكول: حيل هدف الطلب
admin-settings-help-security-protocol-target-mode = ترميز نسبة مئوية مزدوج أو مفرط الطول للنقاط والشرطات المائلة، ونقاط مرمَّزة، وأجزاء نقطية، وأجزاء مسار فارغة (//)، وشرطات مائلة عكسية، وبايتات خام غير ASCII، وهدف بالصيغة المطلقة يسمّي سلطة غير Host.
admin-settings-key-security-protocol-path-length-mode = حارس البروتوكول: طول المسار والاستعلام
admin-settings-help-security-protocol-path-length-mode = مسار أو استعلام أطول من maxPathBytes أو maxQueryBytes. يردّ الإنفاذ بـ 414.
admin-settings-key-security-protocol-method-mode = حارس البروتوكول: أساليب HTTP
admin-settings-help-security-protocol-method-mode = أسلوب خارج allowedMethods (افتراضيًا TRACE وTRACK وCONNECT والأساليب المجهولة أو بأحرف صغيرة). يردّ الإنفاذ بـ 405.
admin-settings-key-security-protocol-duplicate-headers-mode = حارس البروتوكول: ترويسات أحادية القيمة مكرّرة
admin-settings-help-security-protocol-duplicate-headers-mode = ترويسة يجب أن تظهر مرة واحدة تظهر أكثر من مرة (Content-Type وAuthorization وOrigin وReferer وUser-Agent وSec-Fetch-* وترويسات الشرط والنطاق)، أو Content-Length مكرّر بقيم متساوية، أو ترويسات Cookie مكرّرة على HTTP/1.x.
admin-settings-key-security-protocol-forwarded-mode = حارس البروتوكول: ترويسات إعادة التوجيه من أقران غير موثوقين
admin-settings-help-security-protocol-forwarded-mode = Forwarded أو X-Forwarded-* أو X-Real-IP مرسلة من نظير خارج MW_TRUSTED_PROXIES. لا تُوثَق هذه الترويسات في الحالتين؛ وهذا يسجّل المحاولة. تُحتسب في الحماية التكيّفية فقط عند ضبط وكلاء موثوقين.
admin-settings-key-security-protocol-header-hygiene-mode = حارس البروتوكول: سلامة الترويسات
admin-settings-help-security-protocol-header-hygiene-mode = عدد الترويسات، أو قيمة واحدة، أو ترويسة Cookie تتجاوز الحدود المضبوطة؛ وبايتات ترويسة غير ASCII؛ وUpgrade أو Connection: upgrade خارج مسار WebSocket؛ وConnection يسمّي ترويسات مثل Content-Length أو Host. يردّ الإنفاذ بـ 431 لنتائج الحجم والعدد وبـ 400 لغيرها.
admin-settings-key-security-protocol-body-mode = حارس البروتوكول: تأطير جسم الطلب
admin-settings-help-security-protocol-body-mode = GET أو HEAD يحمل جسمًا، أو Content-Length فوق maxBodyBytes (413)، أو Expect غير 100-continue (417) أو دون جسم.
admin-settings-key-security-protocol-max-path-bytes = حارس البروتوكول: أطول مسار (بايت)
admin-settings-help-security-protocol-max-path-bytes = أطول مسار طلب قبل أن تبلّغ عنه فئة طول المسار.
admin-settings-key-security-protocol-max-query-bytes = حارس البروتوكول: أطول استعلام (بايت)
admin-settings-help-security-protocol-max-query-bytes = أطول سلسلة استعلام قبل أن تبلّغ عنها فئة طول المسار.
admin-settings-key-security-protocol-max-header-count = حارس البروتوكول: أكبر عدد من الترويسات
admin-settings-help-security-protocol-max-header-count = أكبر عدد من حقول الترويسة في طلب واحد قبل أن تبلّغ عنه فئة سلامة الترويسات. يظل الحد الصارم للمستمع نفسه (MW_HTTP_MAX_HEADERS) ساريًا.
admin-settings-key-security-protocol-max-header-value-bytes = حارس البروتوكول: أطول قيمة ترويسة (بايت)
admin-settings-help-security-protocol-max-header-value-bytes = أطول قيمة ترويسة واحدة قبل أن تبلّغ عنها فئة سلامة الترويسات.
admin-settings-key-security-protocol-max-cookie-bytes = حارس البروتوكول: أكبر ترويسة Cookie (بايت)
admin-settings-help-security-protocol-max-cookie-bytes = الحجم الإجمالي لترويسات Cookie قبل أن تبلّغ عنه فئة سلامة الترويسات.
admin-settings-key-security-protocol-max-body-bytes = حارس البروتوكول: أكبر جسم معلَن (بايت)
admin-settings-help-security-protocol-max-body-bytes = أكبر Content-Length تقبله فئة الجسم دون الإبلاغ عنه. أبقه فوق أكبر رفع أو استيراد يقبله أي مسار؛ ويمكن لإعفاء بادئة مسار رفعه لمسار واحد.
admin-settings-key-security-protocol-allowed-methods = حارس البروتوكول: الأساليب المسموحة
admin-settings-help-security-protocol-allowed-methods = الأساليب التي تقبلها فئة الأساليب. تسرد القيمة الافتراضية أفعال HTTP المعتادة وأفعال WebDAV وCalDAV وCardDAV؛ ولا يركّب الخادم حاليًا أي مسارات DAV واردة، فتصل هذه إلى 405 عند الموجّه.
admin-settings-key-security-protocol-allowed-hosts = حارس البروتوكول: مضيفون مقبولون إضافيون
admin-settings-help-security-protocol-allowed-hosts = أسماء المضيفين التي تقبلها فئة تثبيت Host إضافة إلى مضيف MW_PUBLIC_URL، مثل اسم داخلي يستخدمه وكيل أو فحص صحة. تُتجاهل المنافذ والنقطة الأخيرة.
admin-settings-key-security-protocol-exempt-prefixes = حارس البروتوكول: بادئات المسارات المعفاة
admin-settings-help-security-protocol-exempt-prefixes = بادئات المسارات (كل منها يبدأ بـ / وأطول من حرف واحد) التي لا تعمل عليها الفئات الاستدلالية، لعميل مشروع يحتاج ذلك، مثل مسار رفع كبير. تطابق أجزاء المسار كاملة. لا تُعفى أبدًا نتائج التأطير والتحكم في المسار، ويُتجاهل /.
admin-settings-key-security-health-mode = الوصول إلى نقطة فحص الصحة
admin-settings-help-security-health-mode = من يجوز له الوصول إلى /healthz و/readyz. internal-only: عناوين العملاء من الحلقة الراجعة والخاصة والمحلية للرابط والمحلية الفريدة. allowlist: هذه مضافًا إليها الشبكات أدناه. open: الجميع. يحصل أي شخص آخر على 404 نفسها لمسار مجهول. الطلب المزوَّد برمز MW_HEALTH_TOKEN مقبول دائمًا. عنوان العميل هو ما حُلَّ عبر وكيل موثوق: خلف وكيل عكسي دون MW_FORWARDED_MODE وMW_TRUSTED_PROXIES يبدو كل طلب كأنه من العنوان الخاص للوكيل، فيُقبل الإنترنت كله.
admin-settings-key-security-health-networks = شبكات نقطة فحص الصحة
admin-settings-help-security-health-networks = عناوين IP أو شبكات CIDR التي يجوز لها الوصول إلى /healthz و/readyz في وضع allowlist، إضافة إلى النطاقات الداخلية، مثل مراقب وقت التشغيل الخارجي.
admin-settings-key-security-spray-enabled = كشف رش كلمات المرور
admin-settings-help-security-spray-enabled = يعدّ أسماء المستخدمين المختلفة التي يفشل بها مصدر واحد. لا يُحفظ في الذاكرة سوى تجزئة مفتاحية لكل اسم مستخدم.
admin-settings-key-security-spray-window-secs = نافذة الرش (بالثواني)

# -- Machine translation (2026-11): added to match en ---------------------
admin-settings-help-security-spray-window-secs = النافذة التي تُحتسب فيها عمليات تسجيل الدخول الفاشلة لمصدر واحد بحسب أسماء المستخدمين المختلفة. الافتراضي 900.
admin-settings-key-security-spray-challenge-at = الرش: حد التحدي
admin-settings-help-security-spray-challenge-at = عدد أسماء المستخدمين المختلفة الفاشلة من مصدر واحد داخل النافذة الذي يفرض تحدي إثبات العمل على ذلك المصدر. لا تُحتسب عمليات تسجيل الدخول الناجحة، فلا يتأثر عنوان مكتب أو حرم جامعي مشترك. الافتراضي 10.
admin-settings-key-security-spray-pace-at = الرش: حد تحديد الوتيرة
admin-settings-help-security-spray-pace-at = عدد أسماء المستخدمين المختلفة الفاشلة الذي يضيف انتظارًا إضافيًا بين محاولات المصدر. الافتراضي 15.
admin-settings-key-security-spray-lock-at = الرش: حد القفل
admin-settings-help-security-spray-lock-at = عدد أسماء المستخدمين المختلفة الفاشلة الذي يقفل المصدر طوال مدة القفل، عبر قفل تسجيل الدخول الحالي. الافتراضي 25.
admin-settings-key-security-spray-pace-secs = الرش: انتظار تحديد الوتيرة (بالثواني)
admin-settings-help-security-spray-pace-secs = الثواني بين محاولات مصدر بلغ حد تحديد الوتيرة أو تجاوزه. الافتراضي 10.
admin-settings-key-security-spray-lock-secs = الرش: مدة القفل (بالثواني)
admin-settings-help-security-spray-lock-secs = مدة القفل المؤقت. فتح المسؤول لقفل المصدر يعيد ضبط عدّه أيضًا. الافتراضي 900.
admin-settings-key-security-spray-known-multiplier = الرش: مضاعف المصدر المعروف
admin-settings-help-security-spray-known-multiplier = مضاعف الحدود الثلاثة للمصدر المعروف، أي الذي له تسجيل دخول ناجح حديث. الافتراضي 3.
admin-settings-key-security-spray-capacity = الرش: المصادر المتتبَّعة
admin-settings-help-security-spray-capacity = أكبر عدد من المصادر المتتبَّعة في الذاكرة؛ وتُسقَط الأقل نشاطًا مؤخرًا أولًا. الافتراضي 20000.
admin-settings-key-security-spike-enabled = كشف الارتفاع المفاجئ على مستوى المثيل
admin-settings-help-security-spike-enabled = يتعلّم خطًا أساسيًا لتسجيلات الدخول الفاشلة ويدخل الوضع المشدَّد عندما يكون المثيل كله أعلى منه بكثير. لا يقفل المثيل أبدًا.
admin-settings-key-security-spike-multiplier-percent = الارتفاع المفاجئ: المضاعف (%)
admin-settings-help-security-spike-multiplier-percent = تُحتسب الإشارة عندما تبلغ هذه النسبة المئوية على الأقل من خطها الأساسي المتعلَّم (400 = أربعة أمثال) وتتجاوز حدها الأدنى المطلق.
admin-settings-key-security-spike-min-failures-per-min = الارتفاع المفاجئ: الحد الأدنى للإخفاقات في الدقيقة
admin-settings-help-security-spike-min-failures-per-min = الحد الأدنى: عدد عمليات تسجيل الدخول الفاشلة في الدقيقة الذي لا تُحتسب دونه إشارة معدل الفشل أبدًا. الافتراضي 20.
admin-settings-key-security-spike-min-sources = الارتفاع المفاجئ: الحد الأدنى للمصادر الفاشلة
admin-settings-help-security-spike-min-sources = الحد الأدنى: عدد المصادر الفاشلة المختلفة في سلة مدتها خمس دقائق الذي لا تُحتسب دونه تلك الإشارة أبدًا. الافتراضي 10.
admin-settings-key-security-spike-min-usernames = الارتفاع المفاجئ: الحد الأدنى لأسماء المستخدمين الفاشلة
admin-settings-help-security-spike-min-usernames = الحد الأدنى: عدد أسماء المستخدمين الفاشلة المختلفة في سلة مدتها خمس دقائق الذي لا تُحتسب دونه تلك الإشارة أبدًا. الافتراضي 30.
admin-settings-key-security-spike-signals-required = الارتفاع المفاجئ: الإشارات المطلوبة
admin-settings-help-security-spike-signals-required = عدد الإشارات التي يجب أن تتجاوز خطها الأساسي وحدها الأدنى معًا. تُحتسب بصمة الرش الموزّع بإشارتين. الافتراضي 2.
admin-settings-key-security-spike-warmup-hours = الارتفاع المفاجئ: فترة التسخين (بالساعات)
admin-settings-help-security-spike-warmup-hours = ساعات الحركة المرصودة قبل أن يمكن بدء الوضع المشدَّد. حتى ذلك الحين يكتفي الخط الأساسي بالتعلّم. الافتراضي 48.
admin-settings-key-security-spike-adapt-hours = الارتفاع المفاجئ: تكيّف الخط الأساسي (بالساعات)
admin-settings-help-security-spike-adapt-hours = الثابت الزمني للخط الأساسي. كلما طال امتص النمو ببطء أكبر. لا يحدّث الارتفاع المفاجئ الخط الأساسي أبدًا. الافتراضي 168.
admin-settings-key-security-spike-duration-secs = الارتفاع المفاجئ: مدة الوضع المشدَّد (بالثواني)
admin-settings-help-security-spike-duration-secs = المدة التي يستمر فيها الوضع المشدَّد بعد آخر دليل على ارتفاع مفاجئ؛ وتُمدَّد ما دامت الإشارات فوق نصف مستوى تفعيلها. الافتراضي 1800.
admin-settings-key-security-spike-force-challenge = الارتفاع المفاجئ: فرض التحدي
admin-settings-help-security-spike-force-challenge = في الوضع المشدَّد، يُطلب تحدي إثبات العمل لعمليات تسجيل الدخول المجهولة من مصادر غير معروفة. لا يتأثر المستخدمون الموثَّقون والمصادر المعروفة.
admin-settings-key-security-spike-pace-factor-percent = الارتفاع المفاجئ: انتظار تسجيل الدخول (%)
admin-settings-help-security-spike-pace-factor-percent = في الوضع المشدَّد، مدة انتظار تسجيل الدخول للمصادر غير المعروفة كنسبة مئوية من الانتظار المعتاد. الافتراضي 300.
admin-settings-key-security-session-binding-enabled = ربط الجلسة
admin-settings-help-security-session-binding-enabled = يربط كل جلسة متصفح بتجزئات مفتاحية لسمات عميلها. يُستثنى العملاء الأصليون الذين يستخدمون رمز حامل ومفاتيح API وعملاء البروتوكولات.
admin-settings-key-security-session-binding-attributes = ربط الجلسة: السمات
admin-settings-help-security-session-binding-attributes = السمات المربوطة: browser وos وhints وlanguage وcountry وnetwork (IPv4 /16 وIPv6 /48). network متوقفة افتراضيًا لأن شبكات الجوال تتنقل. تُتجاهل الأسماء غير المعروفة.
admin-settings-key-security-session-binding-strictness = ربط الجلسة: درجة الصرامة
admin-settings-help-security-session-binding-strictness = يقبل الوضع المتسامح تحديثات المتصفح وتغيّر سمة مرنة واحدة؛ ويشير الوضع الصارم إلى أي اختلاف مرن.
admin-settings-key-security-session-binding-webmail-action = ربط الجلسة: إجراء البريد عبر الويب
admin-settings-help-security-session-binding-webmail-action = ما يفعله عدم تطابق جلسة البريد عبر الويب: off أو detect (تسجيل فقط) أو step-up (طلب كلمة المرور والعامل الثاني مجددًا) أو إلغاء الجلسة. الافتراضي step-up.
admin-settings-key-security-session-binding-admin-action = ربط الجلسة: إجراء وحدة تحكم الإدارة
admin-settings-help-security-session-binding-admin-action = ما يفعله عدم تطابق جلسة وحدة تحكم الإدارة: off أو detect أو step-up أو الإلغاء. الافتراضي الإلغاء.
admin-settings-key-security-theft-enabled = كشف سرقة الجلسات
admin-settings-help-security-theft-enabled = يكشف إعادة استخدام معرّف جلسة جرى تدويره، والسفر المستحيل، والاستخدام المتزامن من بلدان مختلفة.
admin-settings-key-security-theft-rotation-grace-secs = السرقة: مهلة التدوير (بالثواني)
admin-settings-help-security-theft-rotation-grace-secs = بعد تدوير الجلسة، يجوز تقديم المعرّف القديم مجددًا خلال هذه المدة (طلب قيد التنفيذ) قبل أن يُعدّ سرقة. الافتراضي 30.
admin-settings-key-security-theft-min-travel-secs = السرقة: أقل زمن للسفر (بالثواني)
admin-settings-help-security-theft-min-travel-secs = يُعامل تغيّر البلد قبل مرور هذه المدة على الطلب السابق كسفر مستحيل. قد يكون اكتشاف البلد غير دقيق؛ وقد تسبب الشبكات الافتراضية الخاصة وشبكات الجوال تغيّرات خاطئة. الافتراضي 3600.
admin-settings-key-security-theft-concurrent-use = السرقة: الاستخدام المتزامن
admin-settings-help-security-theft-concurrent-use = يشير إلى جلسة واحدة استُخدمت بالتناوب من بلدان (أو شبكات) مختلفة خلال خمس دقائق: off أو country أو network. قد يكون اكتشاف البلد غير دقيق؛ وقد تسبب الشبكات الافتراضية الخاصة وشبكات الجوال تغيّرات خاطئة.
admin-settings-key-security-theft-webmail-action = السرقة: استجابة البريد عبر الويب
admin-settings-help-security-theft-webmail-action = الاستجابة للسفر المستحيل أو الاستخدام المتزامن في جلسة بريد عبر الويب: alert أو step-up أو الإلغاء. إعادة استخدام جلسة جرى تدويرها تؤدي دائمًا إلى الإلغاء. الافتراضي step-up.
admin-settings-key-security-theft-admin-action = السرقة: استجابة وحدة تحكم الإدارة
admin-settings-help-security-theft-admin-action = الاستجابة للسفر المستحيل أو الاستخدام المتزامن في جلسة وحدة تحكم الإدارة: alert أو step-up أو الإلغاء. الافتراضي الإلغاء.
admin-settings-key-security-theft-retention-days = السرقة: الاحتفاظ بالسجلات (بالأيام)
admin-settings-help-security-theft-retention-days = مدة الاحتفاظ بعلامات الجلسات المدوَّرة وسجلات الأمان الخاصة بكل جلسة؛ اجعلها على الأقل بطول أطول عمر للجلسة. الافتراضي 15.
admin-settings-key-security-alerts-country-change = تنبيه تغيّر البلد
admin-settings-help-security-alerts-country-change = يحذّر عند استخدام جلسة مسجَّلة الدخول من بلد غير الذي بدأت فيه. قد يكون اكتشاف البلد غير دقيق؛ وقد تسبب الشبكات الافتراضية الخاصة وشبكات الجوال تغيّرات خاطئة. يمكن للمستخدمين تغيير هذا ما لم يكن مقفلًا؛ ولا يُعمل بإيقاف المستخدم له إلا إذا كان كتم التنبيهات مسموحًا.
admin-settings-key-security-alerts-country-change-enabled = تنبيه تغيّر البلد: المفتاح العام
admin-settings-help-security-alerts-country-change-enabled = الإيقاف يعطّل تنبيه تغيّر البلد للجميع. قد يكون اكتشاف البلد غير دقيق؛ وقد تسبب الشبكات الافتراضية الخاصة وشبكات الجوال تغيّرات خاطئة.
admin-settings-key-security-alerts-country-change-cooldown-secs = تنبيه تغيّر البلد: فترة التهدئة (بالثواني)
admin-settings-help-security-alerts-country-change-cooldown-secs = أقل مدة بين تنبيهات تغيّر البلد لجلسة واحدة. ينبّه كل بلد جديد مرة واحدة لكل جلسة. الافتراضي 300.
admin-settings-key-security-alerts-country-change-user-mute = تنبيه تغيّر البلد: السماح للمستخدمين بالكتم
admin-settings-help-security-alerts-country-change-user-mute = ما إذا كان يجوز للمستخدم إيقاف تنبيه تغيّر البلد الخاص به. عند الإيقاف يواصل الخادم التنبيه حتى لو كان إعداد المستخدم نفسه متوقفًا.
admin-settings-key-security-alerts-channels = قنوات تنبيهات الأمان
admin-settings-help-security-alerts-channels = كيف تصل تحذيرات أمان الجلسة إلى المستخدم: داخل التطبيق، أو كرسالة في صندوق بريده، أو كليهما. يمكن للمستخدمين تغيير هذا ما لم يكن مقفلًا.
admin-settings-key-security-alerts-email-enabled = تنبيهات الأمان عبر البريد الإلكتروني
admin-settings-help-security-alerts-email-enabled = يسمح بتسليم تحذيرات أمان الجلسة إلى صندوق بريد المستخدم نفسه. لا تُرسل أي رسالة عبر SMTP؛ وفي غياب جلسة تسليم يبقى التحذير في التطبيق وسجل التدقيق.
admin-settings-key-security-alerts-sensitivity = حساسية تنبيهات الأمان
admin-settings-help-security-alerts-sensitivity = «منخفضة» تحذّر فقط عند نتائج الموقع ولا ترفع التحقق ولا تلغي؛ و«عادية» تتبع إجراءات المسؤول؛ و«عالية» تضاعف فاصل السفر وتفحص الشبكات المتزامنة أيضًا. يمكن للمستخدمين تغيير هذا ما لم يكن مقفلًا.
admin-settings-key-security-alerts-notice-retention-days = إشعارات الأمان: الاحتفاظ (بالأيام)
admin-settings-help-security-alerts-notice-retention-days = مدة الاحتفاظ بإشعارات الأمان داخل التطبيق لكل حساب (20 كحد أقصى لكل حساب). الافتراضي 30.
