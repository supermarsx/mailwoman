admin-settings-help-folders-reorder-enabled = يتيح للمستخدمين إعادة ترتيب مجلداتهم بسحبها في الشريط الجانبي وفي الإعدادات. يؤدي التعطيل إلى إخفاء مقابض السحب وأوامر النقل. يمكن للمستخدمين تعطيله لأنفسهم ما لم يكن مقفلًا.
admin-settings-key-folders-reorder-allow-nesting = تداخل المجلدات
admin-settings-help-folders-reorder-allow-nesting = يتيح للمستخدمين إفلات مجلد على مجلد آخر لتضمينه فيه، أو إعادته إلى المستوى الأعلى. يُبقي التعطيل كل مجلد تحت أصله الحالي ويسمح بإعادة الترتيب بين المجلدات الشقيقة فقط.
admin-settings-key-folders-reorder-allow-server-move = نقل المجلدات على الخادم
admin-settings-help-folders-reorder-allow-server-move = يتيح أن يغيّر التضمين أو إلغاؤه الأصل الفعلي للمجلد على خادم البريد، فيتغير في كل مكان. يُبقي التعطيل هذه النقلات ترتيبًا داخل هذا التطبيق فقط.
admin-settings-key-folders-reorder-allow-system-folders = نقل مجلدات النظام
admin-settings-help-folders-reorder-allow-system-folders = يتيح للمستخدمين سحب الوارد والمسودات والمرسلة والرسائل غير المرغوب فيها والمهملات والأرشيف لإعادة ترتيبها. يُبقيها التعطيل ثابتة في الأعلى. يُعاد ترتيبها داخل هذا التطبيق فقط، ولا يُعاد تسميتها أو نقلها على الخادم.
admin-settings-key-folders-reorder-max-depth = عمق تداخل المجلدات
admin-settings-help-folders-reorder-max-depth = أعمق مستوى لتداخل المجلدات يمكن أن ينشئه السحب، من 1 إلى 16. يُرفض أي نقل يضع مجلدًا أو أحد مجلداته الفرعية على عمق أكبر.
admin-settings-key-folders-order-locked = تثبيت ترتيب المجلدات
admin-settings-help-folders-order-locked = يثبّت ترتيب المجلدات للجميع ضمن النطاق. يتعطل السحب وأوامر النقل، ويرى المستخدمون تلميح القفل. تبقى التثبيتات والترتيب الذي حدده المسؤول.
admin-settings-key-folders-pinned-admin = المجلدات المثبتة إجباريًا
admin-settings-help-folders-pinned-admin = مجلدات تظهر في مجموعة "المثبتة" أعلى الشريط الجانبي لكل مستخدم. إدخال واحد في كل سطر، بالشكل role:inbox أو مسار مجلد مثل Shared/Support. لا يستطيع المستخدمون إلغاء تثبيتها أو نقلها. يُتخطى أي إدخال لا يطابق مجلدًا.
admin-settings-key-folders-order-default = ترتيب المجلدات الافتراضي
admin-settings-help-folders-order-default = الترتيب الذي تبدأ به المجلدات للمستخدمين الذين لم يرتبوها، من الأول إلى الأخير. إدخال واحد في كل سطر، بالشكل role:<role> أو مسار مجلد. تأتي المجلدات غير المدرجة بعدها بترتيب الخادم. ترتيب المستخدم الخاص يحل محل هذا.
admin-settings-key-folders-new-folder-placement = موضع المجلد الجديد
admin-settings-help-folders-new-folder-placement = المكان الذي يوضع فيه المجلد الذي يظهر على الخادم بين المجلدات الشقيقة: في النهاية، أو بالترتيب الأبجدي.
admin-settings-key-ui-undo-history-max = الحد الأقصى لسجل التراجع والإعادة
admin-settings-help-ui-undo-history-max = أكبر عدد من الإجراءات يمكن لأي مستخدم الاحتفاظ به في سجل التراجع والإعادة، من 0 إلى 50. يُخفَّض حجم المستخدم الخاص إلى هذه القيمة. القيمة 0 تعطّل السجل للجميع. يبقى السجل في علامة تبويب المتصفح ويُمسح عند تسجيل الخروج.
admin-settings-key-ui-bar-mail-top-bar = شريط أدوات البريد
admin-settings-help-ui-bar-mail-top-bar = يُبقي "pinned" شريط أدوات البريد مع عناصر التحكم في التخطيط ظاهرًا دائمًا. أما "auto" فيخفيه خلف مقبض رفيع يفتحه عندما يشير إليه المستخدم أو ينقر عليه أو ينتقل إليه بمفتاح Tab.
admin-settings-key-ui-bar-workspace-tabs = علامات تبويب مساحة العمل
admin-settings-help-ui-bar-workspace-tabs = يُبقي "pinned" شريط علامات تبويب مساحة العمل ظاهرًا دائمًا. أما "auto" فيعرض مقبضًا رفيعًا باسم علامة التبويب النشطة فقط إلى أن يفتحه المستخدم.
admin-settings-key-ui-bar-mail-ribbon = شريط البريد
admin-settings-help-ui-bar-mail-ribbon = لتخطيط الشريط. يُبقي "pinned" الشريط مفتوحًا. أما "auto" فيعرض أسماء علامات التبويب فقط؛ وفتح علامة تبويب يعرض الشريط فوق قائمة الرسائل.
admin-settings-key-ui-bar-composer-ribbon = شريط المحرر
admin-settings-help-ui-bar-composer-ribbon = لكل نوافذ الكتابة. يُبقي "pinned" شريط المحرر مفتوحًا. أما "auto" فيعرض أسماء علامات التبويب فقط؛ وفتح علامة تبويب يدفع نص الرسالة للأسفل بدلًا من تغطيته.
admin-settings-key-appearance-theme = السمة
admin-settings-help-appearance-theme = سمة الألوان التي يراها المستخدمون إلى أن يختاروا سمتهم. يؤدي قفلها إلى إلزام كل المستخدمين بهذه السمة.
admin-settings-key-appearance-accent = لون التمييز
admin-settings-help-appearance-accent = لون التمييز للسمة. الفارغ يعني لون التمييز الخاص بالسمة.
admin-settings-key-appearance-badge-color = لون شارة غير المقروء
admin-settings-help-appearance-badge-color = لون شارات عدد الرسائل غير المقروءة. يُبقي الافتراضي لون السمة؛ ويتبع Accent لون التمييز؛ ويستخدم accent-lighter وaccent-darker لون التمييز أفتح أو أغمق بنسبة 20% مع نص أسود أو أبيض للعدد. القفل يتجاوز اختيار الحساب.
admin-settings-key-appearance-density = الكثافة
admin-settings-help-appearance-density = مقدار المساحة التي تشغلها القوائم وعناصر التحكم: مضغوطة أو مريحة أو واسعة.
admin-settings-key-appearance-font = خط الواجهة
admin-settings-key-packages-allowed = السماح بتتبع الطرود
admin-settings-help-packages-allowed = السماح بتتبع الطرود للحسابات المعنية. يجب أيضًا تفعيل المزوّد في تتبع الطرود، وأن يشترك كل مستخدم فيه. يؤدي تعطيل هذا الإعداد فورًا إلى منع استدعاءات المزوّد الجديدة.
admin-settings-help-appearance-font = اختر خطًا مضمّنًا للحسابات التي ليس لها تفضيل خط، أو اقفل الاختيار لكل الحسابات المعنية. تُحمَّل الخطوط من هذا الخادم؛ ولا يُرسل أي طلب إلى Google Fonts. الافتراضي يستخدم خط السمة.
admin-settings-key-appearance-brand-name = اسم المنتج
admin-settings-help-appearance-brand-name = الاسم الظاهر في صفحة تسجيل الدخول وفي علامة تبويب المتصفح.
admin-settings-key-login-notice = إشعار تسجيل الدخول
admin-settings-help-login-notice = نص قصير يظهر في صفحة تسجيل الدخول، مثل جهة اتصال للدعم. اتركه فارغًا إن لم تُرد شيئًا.
admin-settings-key-mail-read-receipts = إيصالات القراءة
admin-settings-key-receipts-dsn-allowed = طلبات حالة التسليم
admin-settings-help-receipts-dsn-allowed = السماح للحسابات بطلب إشعارات حالة تسليم SMTP. لا يطلب هذا ولا يثبت أن الرسالة قُرئت.
admin-settings-help-mail-read-receipts = ما يحدث عندما تطلب رسالة مفتوحة إيصال قراءة: سؤال المستخدم، أو عدم الإرسال أبدًا، أو الإرسال دائمًا.
admin-settings-key-notifications-enabled = إشعارات البريد الجديد
admin-settings-help-notifications-enabled = ما إذا كان المستخدمون يتلقون إشعارات للبريد الجديد. لا يغيّر ذلك قواعد الإشعارات الخاصة بهم.
admin-settings-key-offline-retention-days = عمر ذاكرة التخزين دون اتصال
admin-settings-help-offline-retention-days = عدد الأيام التي يحتفظ فيها الجهاز بالرسائل للاستخدام دون اتصال. القيمة 0 تعني بلا حد للعمر.
admin-settings-key-offline-budget-mb = حجم ذاكرة التخزين دون اتصال
admin-settings-help-offline-budget-mb = عدد الميغابايت التي يمكن للجهاز استخدامها للبريد دون اتصال. القيمة 0 تعني بلا ذاكرة تخزين دون اتصال.
admin-settings-key-assistant-enabled = مساعد الذكاء الاصطناعي
admin-settings-help-assistant-enabled = ما إذا كان المستخدمون يرون مساعد الذكاء الاصطناعي. ما زال مفتاح النشر في مساعد الذكاء الاصطناعي يسري فوق هذا.
admin-settings-key-assist-profile = ملف تعريف مزوّد الذكاء الاصطناعي
admin-settings-help-assist-profile = معرّف ملف تعريف المزوّد الذي يخدم هؤلاء المستخدمين (مساعد الذكاء الاصطناعي > ملفات تعريف المزوّدين). الفارغ يستخدم نقطة نهاية النشر. معرّف ملف تعريف غير موجود يعطّل مساعد الذكاء الاصطناعي لهؤلاء المستخدمين.
admin-settings-key-upstream-default = خادم البريد الافتراضي
admin-settings-help-upstream-default = خادم البريد الذي يسجّل إليه العنوان الدخول عندما لا يحدد أي نطاق خادمًا. يتقدم جدول النطاقات على هذا.
admin-settings-key-upstream-proxy-timeout-secs = مهلة خادم البريد
admin-settings-help-upstream-proxy-timeout-secs = المدة التي يجوز أن يستغرقها طلب واحد إلى خادم البريد، بالثواني.
admin-settings-key-signin-new-users = المستخدمون الجدد
admin-settings-help-signin-new-users = من يجوز له إنشاء حساب عند أول تسجيل دخول: أي شخص (open)، أو العناوين المضافة مسبقًا فقط (preprovisioned)، أو هؤلاء مع المستخدمين المستوردين (provisioned)، أو لا أحد جديد (closed). لا تتأثر الحسابات الموجودة أبدًا. يُغيَّر في سياسة تسجيل الدخول.
admin-settings-key-signin-new-users-mail = تسجيل الدخول بكلمة المرور: المستخدمون الجدد
admin-settings-help-signin-new-users-mail = قاعدة مستخدم صندوق بريد جديد يسجّل الدخول بكلمة مرور (IMAP أو POP3 أو Exchange). الوراثة تستخدم "المستخدمون الجدد".
admin-settings-key-signin-new-users-sso = تسجيل الدخول الموحّد: المستخدمون الجدد
admin-settings-help-signin-new-users-sso = قاعدة مستخدم جديد يسجّل الدخول عبر تسجيل الدخول الموحّد أو ترويسة موثوقة. الوراثة تستخدم "المستخدمون الجدد".
admin-settings-key-signin-new-users-linked = صناديق البريد المرتبطة: المستخدمون الجدد
admin-settings-help-signin-new-users-linked = قاعدة ربط صندوق بريد ليس له حساب هنا بعد، يُحكم عليها بحسب نطاق صندوق البريد المرتبط نفسه. الوراثة تستخدم "المستخدمون الجدد".
admin-settings-key-signin-new-users-linked-imap = صناديق IMAP المرتبطة: المستخدمون الجدد
admin-settings-help-signin-new-users-linked-imap = قاعدة صناديق IMAP المرتبطة فقط. الوراثة تستخدم "صناديق البريد المرتبطة".
admin-settings-key-signin-new-users-linked-pop3 = صناديق POP3 المرتبطة: المستخدمون الجدد
admin-settings-help-signin-new-users-linked-pop3 = قاعدة صناديق POP3 المرتبطة فقط. الوراثة تستخدم "صناديق البريد المرتبطة".
admin-settings-key-signin-new-users-linked-ews = صناديق Exchange المرتبطة: المستخدمون الجدد
admin-settings-help-signin-new-users-linked-ews = قاعدة صناديق Exchange (EWS) المرتبطة فقط. الوراثة تستخدم "صناديق البريد المرتبطة".
admin-settings-key-signin-preprovision-ttl-days = مدة صلاحية المستخدم المضاف مسبقًا (أيام)
admin-settings-help-signin-preprovision-ttl-days = المدة التي يبقى فيها المستخدم المعلق المضاف مسبقًا صالحًا عند عدم تحديد مدة أخرى.
admin-settings-key-signin-preprovision-max-ttl-days = أطول مدة صلاحية للمستخدم المضاف مسبقًا (أيام)
admin-settings-help-signin-preprovision-max-ttl-days = أطول مدة يجوز للمسؤول منحها لمستخدم معلق مضاف مسبقًا.
admin-settings-key-signin-preprovision-domain-wide = السماح بإدخالات مسبقة لنطاق كامل
admin-settings-help-signin-preprovision-domain-wide = السماح بإدخالات تقبل أي شخص في نطاق كامل، حتى حد معيّن من الاستخدام. معطّل افتراضيًا.
admin-settings-key-signin-preprovision-retention-days = الاحتفاظ بالمستخدمين المعلقين المنتهين (أيام)
admin-settings-help-signin-preprovision-retention-days = المدة التي يُحتفظ فيها بالمستخدم المعلق المنتهي قبل إزالته.
admin-settings-key-signin-domain-mode = نطاقات تسجيل الدخول
admin-settings-help-signin-domain-mode = هل يجوز لأي نطاق تسجيل الدخول أم للنطاقات المدرجة فقط. يُغيَّر في سياسة تسجيل الدخول.
admin-settings-key-signin-refusal-detail = رسائل الرفض
admin-settings-help-signin-refusal-detail = هل يذكر تسجيل الدخول المرفوض السبب (حساب معطّل، عنوان غير مسموح) أم يعطي الجواب نفسه الذي تعطيه كلمة المرور الخاطئة. يُغيَّر في سياسة تسجيل الدخول.
admin-settings-key-signin-ldap-bind-precheck = فحص LDAP قبل تسجيل الدخول
admin-settings-help-signin-ldap-bind-precheck = فحص كلمة المرور مقابل الدليل قبل خادم البريد. يُغيَّر في التكاملات، بعد اختبار الربط.
admin-settings-key-twofa-pending-ttl-secs = المهلة الزمنية للعامل الثاني
admin-settings-help-twofa-pending-ttl-secs = المدة المتاحة للمستخدم لإدخال العامل الثاني بعد كلمة المرور، بالثواني.
admin-settings-key-twofa-max-attempts = محاولات العامل الثاني
admin-settings-help-twofa-max-attempts = عدد رموز العامل الثاني الخاطئة المسموح بها قبل أن يبدأ تسجيل الدخول من جديد.
admin-settings-key-admin-session-idle-secs = مهلة خمول وحدة التحكم
admin-settings-help-admin-session-idle-secs = المدة التي تستمر فيها جلسة وحدة تحكم المسؤول دون طلب، بالثواني.
admin-settings-key-admin-session-absolute-secs = حد جلسة وحدة التحكم
admin-settings-help-admin-session-absolute-secs = أطول مدة تستمر فيها جلسة وحدة تحكم المسؤول، نشطة كانت أم لا، بالثواني.
admin-settings-key-admin-session-rotate-secs = تدوير معرّف جلسة وحدة التحكم
admin-settings-help-admin-session-rotate-secs = كم مرة، بالثواني، تستبدل وحدة تحكم المسؤول معرّف الجلسة أثناء الاستخدام (0 = فقط بعد تأكيد رفع الصلاحية). لا يمدّ التدوير حدّ الخمول أو الحد المطلق.
admin-settings-key-passwd-policy-min-length = الحد الأدنى لطول كلمة المرور
admin-settings-help-passwd-policy-min-length = أقل عدد من الأحرف يجوز أن تتضمنه كلمة المرور الجديدة.
admin-settings-key-passwd-policy-require-upper = اشتراط حرف كبير
admin-settings-help-passwd-policy-require-upper = يجب أن تحتوي كلمة المرور الجديدة على حرف كبير.
admin-settings-key-passwd-policy-require-lower = اشتراط حرف صغير
admin-settings-help-passwd-policy-require-lower = يجب أن تحتوي كلمة المرور الجديدة على حرف صغير.
admin-settings-key-passwd-policy-require-digit = اشتراط رقم
admin-settings-help-passwd-policy-require-digit = يجب أن تحتوي كلمة المرور الجديدة على رقم.
admin-settings-key-passwd-policy-require-symbol = اشتراط رمز
admin-settings-help-passwd-policy-require-symbol = يجب أن تحتوي كلمة المرور الجديدة على حرف ليس حرفًا ولا رقمًا.
admin-settings-key-limit-storage-bytes = حد التخزين
admin-settings-help-limit-storage-bytes = أكبر عدد من البايتات يجوز لمستخدم واحد تخزينه على هذا الخادم. القيمة 0 تعني بلا حد.
admin-settings-key-limit-send-per-day = الرسائل المرسلة في اليوم
admin-settings-help-limit-send-per-day = أكبر عدد من الرسائل يجوز لمستخدم واحد إرساله في اليوم. القيمة 0 تعني بلا حد.
admin-settings-key-limit-ai-calls-per-day = استدعاءات مساعد الذكاء الاصطناعي في اليوم
admin-settings-help-limit-ai-calls-per-day = أكبر عدد من طلبات مساعد الذكاء الاصطناعي يجوز لمستخدم واحد إجراؤها في اليوم. القيمة 0 تعني بلا حد.
admin-settings-key-quota-warn-thresholds = مستويات تحذير الاستخدام
admin-settings-help-quota-warn-thresholds = النسب المئوية من الحد التي يُحذَّر المستخدمون عندها، من الأدنى أولًا.
admin-settings-key-quota-warn-enabled = تحذيرات الاستخدام
admin-settings-help-quota-warn-enabled = هل يُحذَّر المستخدمون عند اقترابهم من حد.
admin-settings-key-usage-retention-days = سجل الاستخدام
admin-settings-help-usage-retention-days = عدد الأيام التي يُحتفظ فيها بأعداد الاستخدام اليومية.
admin-settings-key-usage-meter-api = احتساب استخدام API
admin-settings-help-usage-meter-api = هل تُحتسب طلبات API في أرقام الاستخدام.
admin-settings-key-usage-measure-interval-hours = فاصل قياس التخزين
admin-settings-help-usage-measure-interval-hours = كم مرة تُقاس البيانات المخزنة لكل مستخدم، بالساعات.
admin-settings-key-assistant-rate-limit-per-min = حد معدل مساعد الذكاء الاصطناعي
admin-settings-help-assistant-rate-limit-per-min = أكبر عدد من طلبات مساعد الذكاء الاصطناعي في الدقيقة للخادم بأكمله. القيمة 0 تعني بلا حد.
admin-settings-key-plugins-kv-max-key-bytes = حجم مفتاح الإضافة
admin-settings-help-plugins-kv-max-key-bytes = أطول مفتاح يجوز لإضافة تخزينه، بالبايت.
admin-settings-key-plugins-kv-max-value-bytes = حجم قيمة الإضافة
admin-settings-help-plugins-kv-max-value-bytes = أكبر قيمة يجوز لإضافة تخزينها تحت مفتاح واحد، بالبايت.
admin-settings-key-plugins-kv-max-total-bytes = تخزين الإضافة
