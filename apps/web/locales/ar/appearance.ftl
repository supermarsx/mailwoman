appearance-sync-deployment = السمة الافتراضية لهذا الخادم هي { $theme }.

## Theme names and descriptions (theme/tokens.ts THEME_META)

appearance-theme-dark = داكن
appearance-theme-dark-desc = صفحة شبه سوداء، نص أبيض مائل للرمادي، إجراءات زرقاء، تنبيهات حمراء، علامات صفراء.
appearance-theme-light = فاتح
appearance-theme-light-desc = صفحة بيضاء مائلة للرمادي، نص أسود، إجراءات زرقاء، تنبيهات حمراء، علامات صفراء.
appearance-theme-bauhaus-black = أسود
appearance-theme-bauhaus-black-desc = صفحة سوداء، نص وعناصر تحكم بيضاء، إجراءات زرقاء، تنبيهات حمراء، علامات صفراء.
appearance-theme-paper = ورق
appearance-theme-paper-desc = صفحة بيضاء دافئة، حبر أسود، أزرق وأحمر ومغرة بألوان هادئة.
appearance-theme-blueprint = مخطط أزرق
appearance-theme-blueprint-desc = صفحة زرقاء داكنة، نص وخطوط بيضاء، إجراءات سماوية، علامات صفراء.
appearance-theme-terminal = الطرفية
appearance-theme-terminal-desc = صفحة شبه سوداء، نص أخضر، علامات كهرمانية. الألوان فقط، والخط لا يتغيّر.
appearance-theme-primary = كتل أساسية
appearance-theme-primary-desc = صفحة بيضاء، نص أسود، كتل مسطحة زرقاء وحمراء وصفراء.
appearance-theme-slate-light = أردوازي فاتح
appearance-theme-slate-light-desc = أسطح رمادية مزرقة باردة على صفحة ملوّنة، ولون مميز كحلي هادئ.
appearance-theme-slate-dark = أردوازي داكن
appearance-theme-slate-dark-desc = سمة داكنة رمادية مزرقة باردة بلون مميز أزرق هادئ.
appearance-theme-ocean-light = محيط فاتح
appearance-theme-ocean-light-desc = سمة فاتحة زرقاء مخضرة بلون مميز أزرق مخضر داكن.
appearance-theme-ocean-dark = محيط داكن
appearance-theme-ocean-dark-desc = سمة داكنة زرقاء مخضرة بلون مميز سماوي.
appearance-theme-plum-light = برقوقي فاتح
appearance-theme-plum-light-desc = سمة فاتحة أرجوانية هادئة بلون مميز بنفسجي.
appearance-theme-plum-dark = برقوقي داكن
appearance-theme-plum-dark-desc = سمة داكنة أرجوانية هادئة بلون مميز بنفسجي.
appearance-theme-grove-light = بستان فاتح
appearance-theme-grove-light-desc = درجات ورقية دافئة بنسيج يشبه عروق الخشب ولون مميز طحلبي.
appearance-theme-grove-dark = بستان داكن
appearance-theme-grove-dark-desc = درجات خشب الجوز الدافئة بنسيج يشبه عروق الخشب ولون مميز طحلبي.
appearance-theme-amoled = AMOLED
appearance-theme-amoled-desc = سمة داكنة بالأسود الخالص، وبكسلات مطفأة على شاشات OLED.
appearance-theme-hc-light = تباين عالٍ (فاتح)
appearance-theme-hc-light-desc = أسود على أبيض بحدود سوداء ودون أسطح ملوّنة.
appearance-theme-hc-dark = تباين عالٍ (داكن)
appearance-theme-hc-dark-desc = أبيض على أسود بحدود بيضاء ودون أسطح ملوّنة.

