    {
      "id": "egress-add-route",
      "page": "deploy/egress-proxy.md",
      "session": "admin",
      "seed": [
        "mail-basic",
        "admin-basic"
      ],
      "steps": [
        {
          "goto": "{admin}"
        },
        {
          "click": {
            "role": "link",
            "name": "@privacy-outbound-title",
            "first": true
          }
        },
        {
          "click": {
            "role": "button",
            "name": "@admin-egress-add-heading"
          }
        },
        {
          "waitFor": {
            "testid": "egress-scheme"
          }
        },
        {
          "wait": 1500
        },
        {
          "select": {
            "testid": "egress-scheme",
            "value": "socks5"
          }
        },
        {
          "fill": {
            "label": "@admin-egress-id",
            "value": "office-socks"
          }
        },
        {
          "fill": {
            "label": "@admin-egress-host",
            "value": "proxy.example.net"
          }
        },
        {
          "fill": {
            "label": "@admin-egress-port",
            "value": "1080"
          }
        },
        {
          "eval": "document.activeElement && document.activeElement.blur()"
        }
      ],
      "shot": "full",
      "alt": "The Add a route form filled in for a SOCKS5 proxy at proxy.example.net, port 1080, with the route scope global and two kinds of traffic ticked.",
      "note": "eval removes the focus ring from the last field."
    },
