  "entries": [
    {
      "id": "overview-mailbox",
      "page": "getting-started/what-is-mailwoman.md",
      "steps": [
        {
          "goto": "/"
        },
        {
          "click": {
            "role": "button",
            "name": "Sam Okoye",
            "exact": false
          }
        },
        {
          "waitFor": {
            "role": "heading",
            "name": "Re: Spring catalogue: print proof"
          }
        },
        {
          "click": {
            "role": "heading",
            "name": "Re: Spring catalogue: print proof"
          }
        }
      ],
      "shot": "full",
      "alt": "The Mailwoman mailbox: the folder list on the left, the Inbox message list in the middle and an opened message on the right.",
      "note": "Same state as core/mailbox: a message that is already read, so unread counts are stable."
    },
    {
      "id": "signin-form",
      "page": "getting-started/first-sign-in.md",
      "session": "none",
      "steps": [
        {
          "goto": "/"
        },
        {
          "waitFor": {
            "role": "button",
            "name": "@auth-sign-in"
          }
        }
      ],
      "shot": "full",
      "alt": "The sign-in screen with empty Email or username and Password fields and the Sign in button."
    },
    {
      "id": "signin-filled",
      "page": "getting-started/first-sign-in.md",
      "session": "none",
      "steps": [
        {
          "goto": "/"
        },
        {
          "fill": {
            "label": "@auth-email",
            "value": "alex@example.com"
          }
        },
        {
          "fill": {
            "label": "@auth-password",
            "value": "demo-pass-alex",
            "first": true
          }
        },
        {
          "eval": "document.activeElement && document.activeElement.blur()"
        }
      ],
      "shot": {
        "element": {
          "role": "form",
          "name": "@auth-sign-in"
        },
        "padding": 12
      },
      "callouts": [
        {
          "n": 1,
          "target": {
            "label": "@auth-email"
          },
          "place": "right"
        },
        {
          "n": 2,
          "target": {
            "label": "@auth-password",
            "first": true
          },
          "place": "right"
        },
        {
          "n": 3,
          "target": {
            "role": "button",
            "name": "@auth-sign-in"
          },
          "place": "right"
        }
      ],
      "alt": "The sign-in form with an address in Email or username, a hidden password, and markers 1 to 3 on the address field, the password field and the Sign in button.",
      "note": "eval removes focus from the password field so its tooltip is not in the image."
    },
    {
      "id": "signin-remembered",
      "page": "getting-started/first-sign-in.md",
      "session": "none",
      "steps": [
        {
          "goto": "/"
        },
        {
          "eval": "localStorage.setItem('mw.successful-signins.v1:' + location.origin, JSON.stringify(['alex@example.com', 'jordan.ellis@example.com']))"
        },
        {
          "reload": true
        },
        {
          "click": {
            "role": "button",
            "name": "@auth-remembered"
          }
        },
        {
          "waitFor": {
            "role": "button",
            "name": "jordan.ellis@example.com"
          }
        }
      ],
      "shot": {
        "element": {
          "role": "form",
          "name": "@auth-sign-in"
        },
        "padding": 12
      },
      "alt": "The sign-in form with the Previous sign-ins list open below the address field, listing two addresses, each with a delete icon to forget it.",
      "note": "eval puts two addresses in the browser's remembered sign-ins (the same localStorage key the app writes after a successful sign-in), because the harness signs in through the API, not the form."
    },
