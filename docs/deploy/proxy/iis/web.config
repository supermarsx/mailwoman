<?xml version="1.0" encoding="utf-8"?>
<!--
  Mailwoman behind IIS 10 + Application Request Routing (ARR) 3.0 + URL Rewrite 2.1.

  ===========================================================================
  STATUS: NOT CI-tested, and NOT yet verified against a live IIS install.
  ===========================================================================

  Read README.md in this directory before using this file. It is shipped as a
  reviewable starting point with a runbook, not as a tested configuration, and
  the documentation says so. IIS cannot be covered by the proxy-conformance CI
  matrix: Windows Server Core containers are multi-GB and Windows-container jobs
  on hosted runners are slow and flaky enough that a red cell would tell you
  nothing.

  Several settings that Mailwoman genuinely needs CANNOT be set from web.config
  at all — they live in applicationHost.config and must be applied with appcmd
  or the IIS Manager. README.md lists them with the exact commands. A web.config
  dropped in on its own will get you a site that mostly works and then fails on
  large uploads and on server-sent events.
-->
<configuration>
  <system.webServer>

    <!--
      Request size.

      IIS defaults maxAllowedContentLength to 30000000 bytes (~28.6 MB), which
      is BELOW the application's own 50 MB upload limit — so attachment uploads
      would be rejected by IIS with its own HTML error before the application
      ever saw them. 104857600 (100 MB) is deliberately above the app's limit so
      that an oversized upload reaches the app and the client gets the app's
      JSON error instead.
    -->
    <security>
      <requestFiltering>
        <requestLimits maxAllowedContentLength="104857600" />
      </requestFiltering>
    </security>

    <!--
      WebSocket support for /jmap/ws. The IIS WebSocket Protocol feature must
      also be INSTALLED on the host (see README.md) — this attribute only
      enables an already-installed feature.
    -->
    <webSocket enabled="true" pingInterval="00:00:30" />

    <rewrite>
      <rules>

        <!--
          Rule 1 — provenance.

          Overwrite X-Forwarded-For with the real peer address so that whatever
          the client claimed is discarded, and assert the scheme. {REMOTE_ADDR}
          is the actual TCP peer; {HTTPS} is "on" or "off".

          These <set> elements REQUIRE the corresponding server variables to be
          allow-listed in applicationHost.config first. Without that step IIS
          returns HTTP 500.50 and the rule never runs. See README.md.
        -->
        <rule name="Mailwoman forwarded headers" stopProcessing="false">
          <match url=".*" />
          <serverVariables>
            <set name="HTTP_X_FORWARDED_FOR" value="{REMOTE_ADDR}" />
            <set name="HTTP_X_REAL_IP" value="{REMOTE_ADDR}" />
            <set name="HTTP_X_FORWARDED_HOST" value="{HTTP_HOST}" />
            <!-- Drop any RFC 7239 header the client invented; ARR does not
                 speak it and would pass it through untouched. -->
            <set name="HTTP_FORWARDED" value="" />
          </serverVariables>
          <action type="None" />
        </rule>

        <rule name="Mailwoman forwarded proto (https)" stopProcessing="false">
          <match url=".*" />
          <conditions>
            <add input="{HTTPS}" pattern="^on$" />
          </conditions>
          <serverVariables>
            <set name="HTTP_X_FORWARDED_PROTO" value="https" />
          </serverVariables>
          <action type="None" />
        </rule>

        <rule name="Mailwoman forwarded proto (http)" stopProcessing="false">
          <match url=".*" />
          <conditions>
            <add input="{HTTPS}" pattern="^off$" />
          </conditions>
          <serverVariables>
            <set name="HTTP_X_FORWARDED_PROTO" value="http" />
          </serverVariables>
          <action type="None" />
        </rule>

        <!--
          Rule 2 — server-sent events.

          ARR buffers responses by default, which turns an event stream into
          nothing arriving until the connection closes. Setting
          RESPONSE_BUFFER_LIMIT to 0 disables buffering for the matched request.

          Two endpoints stream. /api/assist/invoke is a POST that returns
          text/event-stream, so a rule keyed on the method or on an
          "/eventsource" path would miss it entirely.
        -->
        <rule name="Mailwoman unbuffered streams" stopProcessing="false">
          <match url="^(jmap/eventsource|api/assist/invoke)$" />
          <serverVariables>
            <set name="RESPONSE_BUFFER_LIMIT" value="0" />
          </serverVariables>
          <action type="None" />
        </rule>

        <!--
          Rule 3 — the proxy itself.

          Requires ARR to be installed AND its proxy feature enabled at server
          level (it is off by default). Adjust the backend address to wherever
          the application is bound.
        -->
        <rule name="Mailwoman proxy" stopProcessing="true">
          <match url="(.*)" />
          <action type="Rewrite" url="http://127.0.0.1:8080/{R:1}" logRewrittenUrl="true" />
        </rule>

      </rules>
    </rewrite>

    <!--
      Do not let IIS compress event streams. IIS applies dynamic compression by
      response MIME type; text/event-stream must not be in that list. This is a
      server-level list, so the block below is a per-site override and its
      effect depends on the parent configuration — verify it rather than
      assuming it.
    -->
    <httpCompression>
      <dynamicTypes>
        <remove mimeType="text/event-stream" />
        <add mimeType="text/event-stream" enabled="false" />
      </dynamicTypes>
    </httpCompression>

    <!--
      IIS emits its own error pages for statuses the backend produced, which
      would replace the application's JSON error bodies with HTML. Pass them
      through untouched.
    -->
    <httpErrors existingResponse="PassThrough" />

  </system.webServer>
</configuration>
