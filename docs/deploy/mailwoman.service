# Hardened systemd unit for Mailwoman (SPEC §7.5).
# Install to /etc/systemd/system/mailwoman.service and provide MW_SERVER_KEY via
# a `systemctl edit mailwoman` drop-in or an 0600 EnvironmentFile — never inline.

[Unit]
Description=Mailwoman webmail server
Documentation=https://github.com/supermarsx/mailwoman
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=mailwoman
Group=mailwoman
ExecStart=/usr/local/bin/mailwoman serve
Restart=on-failure
RestartSec=2s

# --- Configuration -------------------------------------------------------
Environment=MW_BIND=127.0.0.1:8080
Environment=MW_DB_PATH=/var/lib/mailwoman/mailwoman.db
Environment=MW_RENDER_BIN=/usr/local/bin/mw-render
Environment=MW_COOKIE_SECURE=true
Environment=RUST_LOG=info
# Plain log lines in the journal: with colour codes a file-backed fail2ban jail
# cannot read the line's timestamp (docs/deploy/fail2ban.md).
Environment=NO_COLOR=1
# MW_SERVER_KEY comes from a drop-in / EnvironmentFile:
# EnvironmentFile=/etc/mailwoman/mailwoman.env

# --- Filesystem ----------------------------------------------------------
StateDirectory=mailwoman
ReadWritePaths=/var/lib/mailwoman
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true

# --- Privilege / capability lock-down ------------------------------------
NoNewPrivileges=true
CapabilityBoundingSet=
AmbientCapabilities=
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
ProtectProc=invisible
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
# Relaxed: wasmtime compiles plugins with Cranelift and must make the compiled
# code executable (mprotect PROT_EXEC). With this set to true the plugin load
# fails with "component compile: unable to make memory executable"
# (scripts/test-systemd-unit.sh, systemd 255). The server compiles plugins only
# in engine mode (MW_MODE=engine); proxy mode with this set to true is not
# covered by that test.
MemoryDenyWriteExecute=false
RemoveIPC=true
# The render worker is spawned as a child process, so keep fork/exec allowed.
# @sandbox (seccomp, landlock_*) is added because mw-render installs its own
# seccomp filter and Landlock ruleset at start, and @system-service does not
# include them (systemd 255). Without it the worker exits 1 and the server
# refuses to sanitize (503), since the render jail is required on Linux.
SystemCallFilter=@system-service @sandbox
SystemCallErrorNumber=EPERM
SystemCallArchitectures=native
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
UMask=0077

[Install]
WantedBy=multi-user.target
