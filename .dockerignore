# Keep the Docker build context small and reproducible. The web stage
# reinstalls node_modules and the build stage recompiles from source, so
# host build artifacts must never leak in.

# Rust
/target
/target-*
**/target

# Node / web
**/node_modules
apps/web/dist
!apps/web/dist/.gitkeep

# Playwright / test output
test-results
playwright-report
**/.cache

# Local + editor
.git
.gitignore
.env
*.local
.orchestration
.claude
System.Diagnostics.Process
.vscode
.idea

# Docs and CI aren't needed inside the image build
docs
.github

# Generated artifacts can occur below apps/web and other workspace projects.
# Exclude them at every depth so local browser runs never enter build layers.
**/.orchestration
**/test-results
**/playwright-report
**/coverage
**/.vite

# These are validation inputs, not dependencies of the shipped web bundle.
apps/web/e2e
apps/web/src/**/*.test.ts
apps/web/src/**/*.test.tsx
